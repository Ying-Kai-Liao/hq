#!/usr/bin/env python3
"""hq-migrate-state — move the user's state out of the repo into the state folder (one time).

  hq-migrate-state            dry run: what would move, what's running, what would stop
  hq-migrate-state --apply    do it

State is what the agents and the user accumulate: agents/<name>/{memory,data,skills/learned}, shared/user.md,
shared/projects/, projects.json. It moves to $HQ_STATE (default ~/.hq) with the same relative paths, so every tool
that resolves the state folder ($HQ_STATE, else ~/.hq, else the repo) finds it there from the next run on.

--apply: refuses while an hq run is alive; stops the launchd jobs that run agents or their tools (bridge, house);
copies; compares every file's checksum; starts a git repo in the state folder (data/ ignored; sqlite as text dumps
via hq-state); removes the moved files from the repo (git rm, and the untracked data/) and keeps them out with
.gitignore; restarts the jobs. Commit and push are left to you: hq-state commit, then git commit in the repo.
Rollback until you delete anything: the moved files are in the repo's git history (data/ is in the state folder).
"""
import hashlib
import os
import shutil
import subprocess
import sys
from pathlib import Path

HQ = Path(os.environ.get('HQ_ROOT') or os.path.dirname(os.path.dirname(
    os.path.normpath(os.path.join(os.environ.get('PWD') or os.getcwd(), sys.argv[0])))))
TARGET = Path(os.environ.get('HQ_STATE') or Path.home() / '.hq')
JOBS = ('dev.hq.bridge', 'dev.hq.house')      # run agents or write agent data; monitor and cost touch neither
UID = os.getuid()
IGNORE = '''.DS_Store
__pycache__/
# live databases: committed as text dumps (hq-state dump), not as binaries
agents/*/data/*.db
agents/*/data/*.db-*
'''
REPO_IGNORE = '''# state lives in the state folder ($HQ_STATE, default ~/.hq); keep stray writes out of the repo
agents/*/memory/
agents/*/skills/learned/
shared/user.md
shared/projects/
projects.json
'''


def say(msg):
    print(msg, flush=True)


def items():
    """(relative path, is tracked in git) for every piece of state in the repo."""
    out = []
    for a in sorted(p.parent.name for p in (HQ / 'agents').glob('*/agent.md')):
        for sub in ('memory', 'data', 'skills/learned'):
            p = HQ / 'agents' / a / sub
            if p.exists():
                out.append(Path('agents') / a / sub)
    for rel in ('shared/user.md', 'shared/projects', 'projects.json'):
        if (HQ / rel).exists():
            out.append(Path(rel))
    return out


def files(root):
    if root.is_file():
        yield root
        return
    for d, _, fs in os.walk(root):
        for f in fs:
            if f != '.DS_Store':
                yield Path(d) / f


def digest(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()


def live_runs():
    alive = []
    for f in (HQ / '.store').glob('*@*/.runs/*'):
        pid = f.name.split('.', 1)[0]
        try:
            os.kill(int(pid), 0)
            alive.append(f'{f.parent.parent.name} pid {pid}')
        except (ValueError, ProcessLookupError):
            pass
        except PermissionError:
            alive.append(f'{f.parent.parent.name} pid {pid}')
    return alive


def loaded(label):
    return subprocess.run(['launchctl', 'print', f'gui/{UID}/{label}'], capture_output=True).returncode == 0


def plist(label):
    return Path.home() / 'Library' / 'LaunchAgents' / f'{label}.plist'


def main(argv):
    apply = '--apply' in argv
    if any(a in ('-h', '--help') for a in argv):
        print(__doc__.strip())
        return 0
    if (TARGET / 'agents').exists() or (TARGET / 'projects.json').exists():
        say(f'hq-migrate-state: {TARGET} already holds state; nothing to do')
        return 1
    if TARGET.resolve() == HQ.resolve():
        say('hq-migrate-state: the state folder is the repo itself; set HQ_STATE or use ~/.hq')
        return 2
    todo = items()
    n = sum(1 for i in todo for _ in files(HQ / i))
    say(f'state folder: {TARGET}')
    say(f'moves {n} files from {HQ}:')
    for i in todo:
        say(f'  {i}')
    runs = live_runs()
    jobs = [] if '--no-jobs' in argv else [j for j in JOBS if loaded(j)]   # --no-jobs: rehearsal on a copy
    say(f'live hq runs: {", ".join(runs) or "none"}')
    say(f'launchd jobs to stop and restart: {", ".join(jobs) or "none"}')
    say('Claude Code sessions using hq:<name> subagents keep the old paths until restarted; restart them after.')
    if not apply:
        say('dry run; run with --apply to move')
        return 0
    if runs:
        say('hq-migrate-state: hq runs are alive; let them finish (or stop them) and run again')
        return 1

    for j in jobs:
        subprocess.run(['launchctl', 'bootout', f'gui/{UID}/{j}'], capture_output=True)
        say(f'stopped {j}')
    try:
        TARGET.mkdir(parents=True, exist_ok=True)
        for i in todo:
            src, dst = HQ / i, TARGET / i
            dst.parent.mkdir(parents=True, exist_ok=True)
            if src.is_dir():
                shutil.copytree(src, dst, symlinks=True, ignore=shutil.ignore_patterns('.DS_Store', '.gitkeep'),
                                dirs_exist_ok=True)
            else:
                shutil.copy2(src, dst)
        bad = [str(p.relative_to(HQ)) for i in todo for p in files(HQ / i)
               if p.name != '.gitkeep' and digest(p) != digest(TARGET / p.relative_to(HQ))]
        if bad:
            raise SystemExit(f'hq-migrate-state: checksums differ, nothing removed from the repo: {bad[:5]}')
        say(f'copied {n} files; checksums match')

        (TARGET / '.gitignore').write_text(IGNORE)
        if not (TARGET / '.git').exists():
            subprocess.run(['git', 'init', '-q', '-b', 'main'], cwd=TARGET, check=True)
        dump = subprocess.run([str(HQ / 'bin' / 'hq-state'), 'dump'], env={**os.environ, 'HQ_STATE': str(TARGET)})
        if dump.returncode:
            say('warning: hq-state dump failed; run it again before committing the state repo')

        tracked = [str(i) for i in todo if subprocess.run(
            ['git', 'ls-files', '--error-unmatch', str(i)], cwd=HQ, capture_output=True).returncode == 0]
        if tracked:
            subprocess.run(['git', 'rm', '-r', '-q', '--cached', *tracked], cwd=HQ, check=True)
        for i in todo:
            p = HQ / i
            shutil.rmtree(p) if p.is_dir() else p.unlink()
        gi = HQ / '.gitignore'
        text = gi.read_text() if gi.exists() else ''
        if REPO_IGNORE.splitlines()[1] not in text:
            gi.write_text(text.rstrip('\n') + '\n' + REPO_IGNORE)
        say('removed state from the repo (staged); .gitignore keeps it out')
    finally:
        for j in jobs:
            r = subprocess.run(['launchctl', 'bootstrap', f'gui/{UID}', str(plist(j))], capture_output=True, text=True)
            say(f'restarted {j}' if r.returncode == 0 else f'could not restart {j}: {r.stderr.strip()}')
    say(f'done. Next: hq-state commit (state repo), git commit in {HQ}, restart Claude Code sessions.')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
