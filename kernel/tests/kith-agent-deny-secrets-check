#!/usr/bin/env bash
# kith-agent-deny-secrets-check — `kith <agent> --launch-json` denies Read/Edit of the credentials in the state folder
# under both spellings (it may be a link), keeps projects/ and logs/ readable, merges with the role's own deny rules,
# and does not repeat a rule. Throwaway HOME and KITH_HOME; fake `claude` on PATH.
#
#   kernel/tests/kith-agent-deny-secrets-check     a few seconds; exits 1 when a check fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-deny-secrets-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME="$T/real root" KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME
mkdir -p "$HOME" "$KITH_HOME/agents/echo/role" "$T/bin" "$T/real state/projects" "$T/real state/logs"
ln -s "$T/real state" "$T/linked state"   # the state folder as a link, with a space in the target
export KITH_STATE="$T/linked state"
printf -- '---\nname: echo\ndescription: test agent\n---\nYou echo.\n' > "$KITH_HOME/agents/echo/role/agent.md"
printf '{"permissions":{"deny":["Read(~/.codex/auth.json)"]}}' > "$KITH_HOME/agents/echo/role/settings.json"
printf '#!/bin/sh\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"; chmod +x "$T/bin/claude"
export PATH=$T/bin:$PATH

KITH=$KERNEL/bin/kith
fails=0
expect() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1 (got $2, want $3)"; fails=$((fails + 1)); fi; }
# denies: the permissions.deny of a launch-json run, one rule per line.
denies() { (cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json 2>/dev/null) | python3 -c '
import json,sys
j=json.load(sys.stdin)
s=j.get("settings") or {}
if isinstance(s,str): s=json.load(open(s))
print("\n".join(s.get("permissions",{}).get("deny",[])))'; }
n() { grep -cxF -- "$1" <<< "$OUT"; }

OUT=$(denies)
[ -n "$OUT" ] || { echo "FAIL no deny rules found in launch-json"; exit 1; }
for root in "$T/linked state" "$T/real state"; do
  for tool in Read Edit; do
    for f in 'secrets/**' serve/token 'serve/*.db' 'serve/*.db-*' 'browsers/**'; do
      expect "$tool /$root/$f" "$(n "$tool(/$root/$f)")" 1
    done
  done
  expect "projects not denied under $root" "$(grep -cF -- "$root/projects" <<< "$OUT")" 0
  expect "logs not denied under $root" "$(grep -cF -- "$root/logs" <<< "$OUT")" 0
done
expect "role's own deny kept" "$(n 'Read(~/.codex/auth.json)')" 1
expect "no duplicate rules" "$(sort <<< "$OUT" | uniq -d | wc -l | tr -d ' ')" 0
exit $((fails > 0))
