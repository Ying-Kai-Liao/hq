#!/usr/bin/env bash
# kith-serve-check — `kith serve` and `kith` against a stub cargo and a stub kith-serve, in a throwaway HOME and a
# throwaway copy of the repo layout (the real ~/.kith, launchd and host are never touched).
#
#   kernel/tests/kith-serve-check     a few seconds; prints each check, exits 1 when one fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-serve-check.XXXXXX")
trap 'rm -rf "$T"' EXIT
export HOME=$T/home
mkdir -p "$HOME" "$T/repo/kernel/bin" "$T/repo/serve/host/src" "$T/stubs" "$T/target/dev-app"
unset KITH_HOME CARGO_TARGET_DIR KITH_KERNEL_BIN HQ_BIN KITH_SERVE_LAUNCHER KITH_SERVE_ENV
export CARGO_TARGET_DIR=$T/target

cp "$KERNEL/bin/kith-serve" "$KERNEL/bin/kith" "$T/repo/kernel/bin/"
# `kith` forwards to the kith next to it: here a stub that shows what it got.
printf '#!/usr/bin/env bash\necho "kith-stub $*"\n' > "$T/repo/kernel/bin/kith"
chmod +x "$T/repo/kernel/bin/"*
touch "$T/repo/serve/host/Cargo.toml" "$T/repo/serve/host/Cargo.lock" "$T/repo/serve/host/src/main.rs"

# Stub cargo: counts builds, writes the "built" binary (a stub kith-serve that logs its arguments), or fails on demand.
cat > "$T/stubs/cargo" <<'EOF'
#!/usr/bin/env bash
echo "cargo $*" >> "$STUB_LOG"
echo "$PWD env=${KITH_SERVE_ENV:-unset}" >> "$STUB_LOG.build"
if [ -n "${STUB_BUILD_FAIL:-}" ]; then echo "error: boom line"; exit 101; fi
mkdir -p "$CARGO_TARGET_DIR/dev-app"
cat > "$CARGO_TARGET_DIR/dev-app/kith-serve" <<'EOS'
#!/usr/bin/env bash
echo "kith-serve $*" >> "$STUB_LOG"
if [ "$1" = install ]; then echo "${KITH_KERNEL_BIN:-}" >> "$STUB_LOG.kith"; echo "${HQ_BIN:-}" >> "$STUB_LOG.hqbin"; echo "${KITH_SERVE_LAUNCHER:-}" >> "$STUB_LOG.launcher"; fi
EOS
chmod +x "$CARGO_TARGET_DIR/dev-app/kith-serve"
EOF
chmod +x "$T/stubs/cargo"
export STUB_LOG=$T/log
: > "$STUB_LOG"
SYSPATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH=$T/stubs:$SYSPATH
SERVE=$T/repo/kernel/bin/kith-serve
BIN=$HOME/.kith/serve/bin/kith-serve

fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
count() { grep -c "$1" "$STUB_LOG" || true; }

# start: builds when missing, copies, installs on 19224
out=$("$SERVE" start 2>&1); rc=$?
check "start succeeds" "[ $rc = 0 ]"
check "start builds with the dev-app profile" "grep -q 'cargo build --profile dev-app --manifest-path .*/serve/host/Cargo.toml' '$STUB_LOG'"
check "start copies the binary to ~/.kith/serve/bin" "[ -x '$BIN' ]"
check "start calls install --port 19224" "grep -q 'kith-serve install --port 19224' '$STUB_LOG'"

check "start installs the job with this checkout's kith" "grep -q '/repo/kernel/bin/kith\$' '$STUB_LOG.kith'"
check "start builds from inside serve/host (the pinned toolchain applies)" "grep -q '/repo/serve/host env=' '$STUB_LOG.build'"

# start again: cargo is asked every time (it decides what is fresh); install is still called
"$SERVE" start >/dev/null 2>&1
check "second start runs cargo again" "[ $(count 'cargo build') = 2 ]"
check "second start installs again" "[ $(count 'kith-serve install') = 2 ]"

# --no-build never runs cargo
"$SERVE" start --no-build >/dev/null 2>&1
check "--no-build never runs cargo" "[ $(count 'cargo build') = 2 ]"

: > "$STUB_LOG.kith"; KITH_KERNEL_BIN=/elsewhere/kith "$SERVE" start --no-build >/dev/null 2>&1
check "an explicit KITH_KERNEL_BIN is kept (and handed on as HQ_BIN too)" "grep -qx '/elsewhere/kith' '$STUB_LOG.kith' && grep -qx /elsewhere/kith '$STUB_LOG.hqbin'"
: > "$STUB_LOG.build"; KITH_SERVE_ENV=main "$SERVE" start >/dev/null 2>&1
check "an exported KITH_SERVE_ENV never reaches the build" "grep -q 'env=unset' '$STUB_LOG.build' && ! grep -q 'env=main' '$STUB_LOG.build'"

# a relative CARGO_TARGET_DIR is resolved before the build moves into serve/host
mkdir -p "$T/work"; rm -rf "$T/work/reltarget"; rm -f "$BIN"
(cd "$T/work" && CARGO_TARGET_DIR=reltarget "$SERVE" start >/dev/null 2>&1)
check "a relative CARGO_TARGET_DIR still installs the fresh build" "[ -x '$BIN' ] && [ -x '$T/work/reltarget/dev-app/kith-serve' ]"

# a failing build keeps the old installed binary and exits non-zero, with the tail shown
before=$(cksum < "$BIN")
out=$(STUB_BUILD_FAIL=1 "$SERVE" start 2>&1); rc=$?
check "failed build exits non-zero" "[ $rc != 0 ]"
check "failed build shows the output tail" "echo \"\$out\" | grep -q 'boom line'"
check "failed build keeps the installed binary" "[ \"$before\" = \"\$(cksum < '$BIN')\" ]"

# no cargo at all (and no rustup toolchains): a clear error
if PATH=$SYSPATH command -v cargo >/dev/null 2>&1; then
  echo "skip no cargo: clear error (a system cargo is on $SYSPATH)"
else
  out=$(PATH=$SYSPATH "$SERVE" start 2>&1); rc=$?
  check "no cargo: clear error" "[ $rc != 0 ] && echo \"\$out\" | grep -q 'cargo not found'"
fi

# stop and status forward to the host
"$SERVE" stop >/dev/null 2>&1
check "stop forwards" "grep -qx 'kith-serve stop' '$STUB_LOG'"
out=$("$SERVE" status 2>&1)
check "status forwards with the port" "grep -q 'kith-serve status --port 19224' '$STUB_LOG'"
check "status says relay is the built-in default" "echo \"\$out\" | grep -q 'relay: built-in default'"
check "relay with no argument says the default too" "'$SERVE' relay | grep -q 'built-in default'"

# no launcher unless one is configured: hq-uv alone changes nothing; a configured one is passed on
mkdir -p "$HOME/.kith/bin"; printf '#!/bin/sh\n' > "$HOME/.kith/bin/hq-uv"; chmod +x "$HOME/.kith/bin/hq-uv"
: > "$STUB_LOG.launcher"; "$SERVE" start --no-build >/dev/null 2>&1
check "hq-uv present: no launcher by default" "! grep -q . '$STUB_LOG.launcher'"
: > "$STUB_LOG.launcher"; KITH_SERVE_LAUNCHER='["x"]' "$SERVE" start --no-build >/dev/null 2>&1
check "a configured launcher is kept" "grep -qx '\\[\"x\"\\]' '$STUB_LOG.launcher'"
rm -f "$HOME/.kith/bin/hq-uv"

# restart: stop, then install without building
: > "$STUB_LOG"
"$SERVE" restart >/dev/null 2>&1
check "restart stops then installs, no build" "[ \"\$(tr '\n' '|' < '$STUB_LOG')\" = 'kith-serve stop|kith-serve install --port 19224|' ]"

# relay: set, keep other keys, reject bad URLs
CFG=$HOME/.kith/serve/config.json
echo '{"other": 1}' > "$CFG"
"$SERVE" relay https://relay.example.workers.dev >/dev/null 2>&1
check "relay sets relay_url and keeps other keys" "python3 -c 'import json; c=json.load(open(\"$CFG\")); assert c==dict(other=1, relay_url=\"https://relay.example.workers.dev\")'"
out=$("$SERVE" status 2>&1)
check "status shows the configured relay" "echo \"\$out\" | grep -q '^relay: https://relay.example.workers.dev (config.json)'"
"$SERVE" relay http://localhost:8787 >/dev/null 2>&1
check "relay accepts http://localhost" "grep -q localhost '$CFG'"
out=$("$SERVE" relay ftp://nope 2>&1); rc=$?
check "relay rejects a bad URL" "[ $rc != 0 ] && grep -q localhost '$CFG'"
out=$("$SERVE" relay http://evil.example.com 2>&1); rc=$?
check "relay rejects plain http to other hosts" "[ $rc != 0 ]"
# two writers at once: both succeed, the file stays valid JSON, no temp files are left behind
echo '{}' > "$CFG"; pids=(); for i in 1 2 3 4 5 6; do "$SERVE" relay "https://r$i.example.workers.dev" >/dev/null 2>&1 & pids+=($!); done
failed=0; for p in "${pids[@]}"; do wait "$p" || failed=$((failed + 1)); done
check "overlapping relay writes all succeed" "[ $failed = 0 ]"
check "overlapping relay writes leave one of the urls and no temp files" "python3 -c 'import json; u=json.load(open(\"$CFG\"))[\"relay_url\"]; assert u in [\"https://r%d.example.workers.dev\" % i for i in range(1, 7)]' && [ \"\$(ls -A '$HOME/.kith/serve' | grep -c config.json.)\" = 0 ]"
rm -rf "$HOME/.kith"
"$SERVE" relay https://relay.example.workers.dev >/dev/null 2>&1
check "relay creates the file and folder" "[ -f '$CFG' ]"
check "relay with no argument shows it" "'$SERVE' relay | grep -q relay.example.workers.dev"

# kith forwards everything to kith; a symlink to it works too
out=$("$T/repo/kernel/bin/kith" serve status --x 2>&1)
check "kith forwards to kith" "[ \"\$out\" = 'kith-stub serve status --x' ]"
ln -s "$T/repo/kernel/bin/kith" "$T/stubs/kith"
check "kith through a symlink forwards" "[ \"\$(kith serve help)\" = 'kith-stub serve help' ]"

# the real kith dispatches `serve` to kith-serve
out=$("$KERNEL/bin/kith" serve help 2>&1)
check "kith serve help prints usage" "echo \"\$out\" | grep -q 'kith serve start'"

# a packaged install (no serve/ source): installs the kith binary beside share/ under the name kith-serve, no cargo
P=$T/pkg; mkdir -p "$P/bin" "$P/share/kith/kernel/bin" "$HOME/.kith/serve"
cp "$KERNEL/bin/kith-serve" "$P/share/kith/kernel/bin/"
printf '#!/usr/bin/env bash\necho "kith-bin $*" >> "$STUB_LOG"\n' > "$P/bin/kith"; chmod +x "$P/bin/kith" "$P/share/kith/kernel/bin/kith-serve"
rm -rf "$HOME/.kith/serve/bin"; : > "$STUB_LOG"
out=$("$P/share/kith/kernel/bin/kith-serve" start 2>&1); rc=$?
check "packaged start succeeds" "[ $rc = 0 ]"
check "packaged start never runs cargo" "! grep -q '^cargo' '$STUB_LOG'"
check "packaged start installs the kith binary as kith-serve" "cmp -s '$P/bin/kith' '$BIN'"
check "packaged start installs the job" "grep -q 'install --port 19224' '$STUB_LOG'"

# the Mac app's main bundle (share/kith/env says main) keeps to the main data dir and port, never the dev ones
echo main > "$P/share/kith/env"; rm -rf "$HOME/.kith/serve/bin"; : > "$STUB_LOG"
out=$("$P/share/kith/kernel/bin/kith-serve" start 2>&1); rc=$?
check "main bundle start succeeds" "[ $rc = 0 ]"
check "main bundle installs under serve-main" "cmp -s '$P/bin/kith' '$HOME/.kith/serve-main/bin/kith-serve'"
check "main bundle uses port 19225" "grep -q 'install --port 19225' '$STUB_LOG'"
check "main bundle leaves the dev dir alone" "[ ! -e '$HOME/.kith/serve/bin' ]"

[ $fails = 0 ] && echo "all good" || { echo "$fails check(s) failed"; exit 1; }
