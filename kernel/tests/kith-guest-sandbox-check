#!/usr/bin/env bash
# kith-guest-sandbox-check — every run for anyone but the owner (an invited person, a bot) carries Claude Code's OS
# sandbox in its generated settings: enabled, fail closed, no escape hatch, no excluded commands, the credential folders
# (both spellings) and the membership's Read denials unreadable, only the run's own folders writable, no network but the
# host socket. The owner's settings carry no "sandbox" key at all. Inspects the JSON of `--launch-json`; no real claude,
# so it runs on Linux CI. Throwaway HOME and KITH_HOME; fake `claude` on PATH.
#
#   kernel/tests/kith-guest-sandbox-check     a few seconds; exits 1 when a check fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-guest-sandbox-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME="$T/real root" KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME KITH_SERVE_HOME KITH_RUN_TOKEN KITH_RUN_SOCKET
mkdir -p "$HOME" "$KITH_HOME/agents/echo/role" "$KITH_HOME/agents/other/role" "$T/bin" "$T/real state/projects" "$T/real state/logs"
ln -s "$T/real state" "$T/linked state"   # the state folder as a link, with a space in the target
export KITH_STATE="$T/linked state"
printf -- '---\nname: echo\ndescription: test agent\n---\nYou echo.\n' > "$KITH_HOME/agents/echo/role/agent.md"
printf -- '---\nname: other\ndescription: another agent\n---\nYou other.\n' > "$KITH_HOME/agents/other/role/agent.md"
printf '#!/bin/sh\n[ "$1" = "--version" ] && echo "2.1.309 (Claude Code)"\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"; chmod +x "$T/bin/claude"
export PATH=$T/bin:$PATH

KITH=$KERNEL/bin/kith
AUTH=$KERNEL/bin/kith-auth
fails=0
expect() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1 (got $2, want $3)"; fails=$((fails + 1)); fi; }

"$AUTH" person guest name=Guest >/dev/null 2>&1
"$AUTH" member echo guest mode=default 'deny=Read(//data/private/**),Read(//data/notes/*.md),Read(//data/exact.txt)' >/dev/null 2>&1
"$AUTH" bot bot-3f9a1c2e --of guest name=Bot >/dev/null 2>&1
"$AUTH" member echo bot-3f9a1c2e mode=default >/dev/null 2>&1

# settings: the generated settings of a run, as JSON ({} when the run does not start).
settings() { (cd "$KITH_HOME/agents/echo" && "$KITH" echo --launch-json 2>/dev/null) | python3 -c '
import json,sys
j=json.load(sys.stdin)
s=j.get("settings") or {}
if isinstance(s,str): s=json.load(open(s))
json.dump(s,sys.stdout,sort_keys=True)'; }
# q: a python expression over the settings s (the sandbox block sb).
q() { SJ=$1 python3 -c '
import json,os,sys
s=json.loads(os.environ["SJ"]); sb=s.get("sandbox",{})
fs=sb.get("filesystem",{}); dr=fs.get("denyRead",[]); aw=fs.get("allowWrite",[])
print(eval(sys.argv[1]))' "$2"; }

OWNER=$(settings)
expect "owner: no sandbox key" "$(q "$OWNER" '"sandbox" in s')" False
expect "owner: settings not empty" "$(q "$OWNER" 'bool(s.get("permissions"))')" True

for who in guest bot-3f9a1c2e; do
  S=$(KITH_PERSON=$who settings)
  expect "$who: sandbox on, fail closed, no escape hatch" "$(q "$S" '(sb.get("enabled"), sb.get("failIfUnavailable"), sb.get("allowUnsandboxedCommands"))')" "(True, True, False)"
  expect "$who: no excluded commands" "$(q "$S" '"excludedCommands" in sb')" False
  expect "$who: no network but the socket (none given)" "$(q "$S" 'sb["network"]')" "{'allowUnixSockets': []}"
  expect "$who: allowLocalBinding never set" "$(q "$S" '"allowLocalBinding" in sb["network"] or "allowedDomains" in sb["network"]')" False
  for root in "$T/linked state" "$T/real state"; do
    for f in index serve secrets browsers bridge; do
      expect "$who: denyRead $root/$f" "$(q "$S" "'$root/$f' in dr")" True
    done
  done
  expect "$who: denyRead the other agent's folder (both spellings)" "$(q "$S" "'$KITH_HOME/agents/other' in dr")" True
  expect "$who: denyRead the owner user.md" "$(q "$S" "'$T/linked state/user.md' in dr and '$T/real state/user.md' in dr")" True
  expect "$who: allowWrite is the run's own folders, not the state root" "$(q "$S" "'$T/real state' not in aw and '$T/linked state' not in aw and any('/memory/' in a for a in aw)")" True
  expect "$who: the home folder is denied (both spellings), with a narrow allowlist of reads" "$(q "$S" "'$HOME' in dr and len(fs['allowRead']) > 0 and '/' not in fs['allowRead'] and '$HOME' not in fs['allowRead']")" True
  expect "$who: allowRead has the kernel, the run's own memory and the working directory" "$(q "$S" "all(any(a == x for a in fs['allowRead']) for x in ['$KERNEL', '$KITH_HOME/agents/echo/memory/shared'])")" True
  expect "$who: the file tools are limited to the working directories" "$(q "$S" 's["permissions"].get("blockReadsOutsideWorkingDirectories")')" True
  expect "$who: the denies stay on top of the allowlist (index not allowed)" "$(q "$S" "not any(a == '$T/real state/index' or a == '$T/real state' for a in fs['allowRead'])")" True
  expect "$who: global config of the owner is not read" "$(q "$S" 's["env"]["GIT_CONFIG_GLOBAL"]')" /dev/null
  expect "$who: the link to the state folder is itself readable" "$(q "$S" "'$T/linked state' in fs['allowRead']")" True
  expect "$who: the Read/Edit deny rules stay" "$(q "$S" 'any(r.startswith("Read(") for r in s["permissions"]["deny"])')" True
done

# the host socket: allowed when the run has one, and the names pass through the launch JSON env
SOCK=$T/real\ state/run/host.sock
S=$(KITH_PERSON=guest KITH_RUN_SOCKET=$SOCK KITH_RUN_TOKEN=tok settings)
expect "guest with a socket: allowUnixSockets is exactly that path" "$(q "$S" "sb['network']['allowUnixSockets'] == ['$SOCK']")" True
expect "guest with a socket: the socket's folder is not denied" "$(q "$S" "not any('$SOCK'.startswith(d + '/') or '$SOCK' == d for d in dr)")" True
# globs in the membership Read rules deny the parent folder
S=$(KITH_PERSON=guest settings)
expect "glob rules: dir/** and dir/*.md deny the folder, an exact file denies itself" "$(q "$S" "all(x in dr for x in ['/data/private', '/data/notes', '/data/exact.txt'])")" True
ENVJ=$(cd "$KITH_HOME/agents/echo" && KITH_PERSON=guest KITH_RUN_SOCKET=$SOCK KITH_RUN_TOKEN=tok "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; e=json.load(sys.stdin)["env"]; print(e.get("KITH_RUN_SOCKET")=="'"$SOCK"'", e.get("KITH_RUN_TOKEN")=="tok")')
expect "launch JSON env carries KITH_RUN_SOCKET and KITH_RUN_TOKEN" "$ENVJ" "True True"
OWNER2=$(cd "$KITH_HOME/agents/echo" && KITH_RUN_SOCKET=$SOCK "$KITH" echo --launch-json 2>/dev/null | python3 -c 'import json,sys; s=json.load(sys.stdin)["settings"]; print("sandbox" in s)')
expect "owner with a socket set: still no sandbox" "$OWNER2" False

# KITH_SERVE_HOME elsewhere is denied too
mkdir -p "$T/elsewhere"
S=$(KITH_PERSON=guest KITH_SERVE_HOME=$T/elsewhere settings)
expect "KITH_SERVE_HOME: denied" "$(q "$S" "'$T/elsewhere' in dr")" True

# Claude Code older than 2.1.257 (or one that does not say) cannot enforce the read limits: no run for a guest, the owner unaffected
printf '#!/bin/sh\n[ "$1" = "--version" ] && echo "2.1.100 (Claude Code)"\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"
KITH_PERSON=guest "$KITH" echo --launch-json >/dev/null 2>&1; rc=$?
expect "old Claude Code: a guest run is refused" "$rc" 3
printf '#!/bin/sh\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"
KITH_PERSON=guest "$KITH" echo --launch-json >/dev/null 2>&1; rc=$?
expect "Claude Code that gives no version: a guest run is refused" "$rc" 3
"$KITH" echo --launch-json >/dev/null 2>&1; rc=$?
expect "old Claude Code: the owner still runs" "$rc" 0

# a person with no membership never gets settings at all
KITH_PERSON=stranger "$KITH" echo --launch-json >/dev/null 2>&1; rc=$?
expect "a stranger: refused before any run" "$rc" 3
exit $((fails > 0))
