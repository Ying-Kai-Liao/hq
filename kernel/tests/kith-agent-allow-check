#!/usr/bin/env bash
# kith-agent-allow-check — `kith <agent> --launch-json` adds no allow rules of its own for the owner's run
# beyond the memory/skills Edit list: nothing from capabilities.yaml `tools:` and no read of the agent's own folder.
# The role's settings.json allow/deny rules pass through, every deny rule stays, and the mode reaches claude unchanged,
# but for a retired one (manual, dontAsk), which reads as the mode that replaced it wherever it was stored.
# Throwaway HOME and KITH_HOME; fake `claude` on PATH.
#
#   kernel/tests/kith-agent-allow-check     a few seconds; exits 1 when a check fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-agent-allow-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME="$T/real root" KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME
mkdir -p "$HOME" "$T/bin" "$T/state/projects"
export KITH_STATE=$T/state
mkagent() {   # name, capabilities.yaml text ("" for none)
  mkdir -p "$KITH_HOME/agents/$1/role"
  printf -- '---\nname: %s\ndescription: test agent\n---\nYou work.\n' "$1" > "$KITH_HOME/agents/$1/role/agent.md"
  printf '{"permissions":{"deny":["Read(~/.codex/auth.json)"],"allow":["Bash(echo:*)"]}}' > "$KITH_HOME/agents/$1/role/settings.json"
  [ -n "$2" ] && printf '%s\n' "$2" > "$KITH_HOME/agents/$1/role/capabilities.yaml"
  return 0
}
mkagent plain ""
mkagent artist "tools: [image-generation, artifacts, browser]"
mkagent blocky "tools:
  - infographic             # headless Chrome
  - render
  - img (local)"
mkagent unk "tools: [mystery]"
mkdir -p "$HOME/kith/agents" && ln -s "$KITH_HOME/agents/artist" "$HOME/kith/agents/artist"
printf '#!/bin/sh\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"; chmod +x "$T/bin/claude"
export PATH=$T/bin:$PATH

KITH=$KERNEL/bin/kith
fails=0
expect() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1 (got $2, want $3)"; fails=$((fails + 1)); fi; }
# rules KIND AGENT: permissions.KIND of a launch-json run, one rule per line.
rules() { (cd "$KITH_HOME/agents/$2" && "$KITH" "$2" --launch-json 2>/dev/null) | KIND=$1 python3 -c '
import json,os,sys
j=json.load(sys.stdin)
s=j.get("settings") or {}
if isinstance(s,str): s=json.load(open(s))
print("\n".join(s.get("permissions",{}).get(os.environ["KIND"],[])))'; }
n() { grep -cxF -- "$1" <<< "$OUT"; }

home=$KITH_HOME/agents/artist
OUT=$(rules allow artist)
[ -n "$OUT" ] || { echo "FAIL no allow rules found in launch-json"; exit 1; }
expect "role's own allow kept" "$(n 'Bash(echo:*)')" 1
expect "Edit memory/ still allowed (one-shot runs save memory)" "$(n "Edit(/$home/memory/**)")" 1
expect "no Read of own folder" "$(grep -c '^Read(' <<< "$OUT")" 0
for sub in data files; do expect "no Edit of $sub/" "$(n "Edit(/$home/$sub/**)")" 0; done
expect "tools: artifacts approves nothing" "$(grep -c 'Artifact' <<< "$OUT")" 0
expect "tools: browser approves nothing" "$(grep -c 'Chrome' <<< "$OUT")" 0
expect "tools: render approves nothing" "$(grep -c 'python3' <<< "$OUT")" 0
expect "no duplicate rules" "$(sort <<< "$OUT" | uniq -d | wc -l | tr -d ' ')" 0
OUT=$(rules deny artist)
expect "role's deny kept" "$(n 'Read(~/.codex/auth.json)')" 1
expect "secrets deny kept" "$(grep -c 'secrets/\*\*' <<< "$OUT")" 2
OUT=$(rules allow blocky)
expect "block list tools: no Chrome" "$(grep -c 'Chrome' <<< "$OUT")" 0
OUT=$(rules allow unk)
expect "unknown tag adds nothing" "$(grep -c 'Bash\|Artifact' <<< "$OUT")" 1   # only the role's Bash(echo:*)

# Role rules for kernel tools name {{KITH}}/{{HQ}} bare; a kernel path with a space is called quoted, so the quoted
# spelling is allowed too (once, also when the role already has it). The kernel is reached through a path with a space.
mkagent kt ""
printf '%s' '{"permissions":{"allow":["Bash({{KITH}}/bin/project-id --where:*)","Bash({{HQ}}/bin/hq-send --as kt:*)",
  "Bash({{KITH}}/bin/kith-who:*)","Bash(\"{{KITH}}/bin/kith-who\":*)"],"deny":["Bash({{KITH}}/bin/kith-auth)"]}}' > "$KITH_HOME/agents/kt/role/settings.json"
ln -s "$KERNEL" "$T/a kernel"
KITH="$T/a kernel/bin/kith"
K="$T/a kernel/bin"
OUT=$(rules allow kt)
expect "kernel rule kept bare" "$(n "Bash($K/project-id --where:*)")" 1
expect "kernel rule quoted" "$(n "Bash(\"$K/project-id\" --where:*)")" 1
expect "{{HQ}} rule quoted" "$(n "Bash(\"$K/hq-send\" --as kt:*)")" 1
expect "already quoted: once" "$(n "Bash(\"$K/kith-who\":*)")" 1
expect "no duplicate rules" "$(sort <<< "$OUT" | uniq -d | wc -l | tr -d ' ')" 0
OUT=$(rules deny kt)
expect "kernel deny quoted" "$(n "Bash(\"$K/kith-auth\")")" 1
# The mode: a stored 'manual' reads as default and 'dontAsk' as auto; the five modes kith offers pass through; the
# retired ones are refused on set.
mkdir -p "$KITH_HOME/machine"
SETTINGS=$(python3 "$KERNEL/lib/kith_paths.py" --sh | sed -n 's/^export KITH_MACHINE=//p' | tr -d "'\"")
mkdir -p "$SETTINGS"
printf '{"permission_mode":"manual","agents":{"plain":{"permission_mode":"manual"},"unk":{"permission_mode":"plan"}}}' > "$SETTINGS/settings.json"
expect "stored manual (global) reads as default" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode)" default
expect "stored manual (agent) reads as default" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode plain)" default
expect "other agent's mode kept" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode unk)" plan
for m in manual dontAsk; do
  python3 "$KERNEL/lib/kith_settings.py" set permission_mode plain $m >/dev/null 2>&1
  expect "set $m is refused" "$?" 1
done
for m in default acceptEdits plan auto bypassPermissions; do
  python3 "$KERNEL/lib/kith_settings.py" set permission_mode plain $m >/dev/null 2>&1
  expect "mode $m accepted and read back" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode plain)" $m
done
# A stored dontAsk, wherever it is, starts the run in auto: what --info-json and --launch-json report, and the
# defaultMode the run's settings carry.
info() { (cd "$KITH_HOME/agents/$1" && "$KITH" "$1" --info-json 2>/dev/null) | python3 -c 'import json,sys; print(json.load(sys.stdin)["permission_mode"])'; }
launch() { (cd "$KITH_HOME/agents/$1" && "$KITH" "$1" --launch-json 2>/dev/null) | python3 -c '
import json,sys
j=json.load(sys.stdin)
s=j.get("settings") or {}
if isinstance(s,str): s=json.load(open(s))
print(j["permission_mode"], s.get("permissions",{}).get("defaultMode"))'; }
printf '{"permission_mode":"dontAsk","agents":{"plain":{"permission_mode":"dontAsk"}}}' > "$SETTINGS/settings.json"
expect "stored dontAsk (global) reads as auto" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode)" auto
expect "stored dontAsk (agent): --info-json" "$(info plain)" auto
expect "stored dontAsk (agent): --launch-json" "$(launch plain)" "auto None"
expect "stored dontAsk (global): --launch-json" "$(launch artist)" "auto auto"
printf '{}' > "$SETTINGS/settings.json"
printf '{"permissions":{"defaultMode":"dontAsk"}}' > "$KITH_HOME/agents/unk/role/settings.json"
expect "agent's defaultMode dontAsk: --info-json" "$(info unk)" auto
expect "agent's defaultMode dontAsk: --launch-json" "$(launch unk)" "auto auto"
expect "caller's dontAsk: --launch-json" "$(KITH_PERMISSION_MODE=dontAsk launch plain)" "auto None"
# kith doctor says where it found one.
printf '{"permission_mode":"dontAsk","agents":{"plain":{"permission_mode":"dontAsk"}}}' > "$SETTINGS/settings.json"
DOC=$("$KERNEL/bin/kith-doctor" 2>&1)
expect "doctor: stored dontAsk (global)" "$(grep -c ': permission_mode is dontAsk, which kith no longer offers' <<< "$DOC")" 1
expect "doctor: stored dontAsk (agent)" "$(grep -c 'agents.plain.permission_mode is dontAsk, which kith no longer offers' <<< "$DOC")" 1
expect "doctor: agent's defaultMode dontAsk" "$(grep -c 'unk (.*defaultMode is dontAsk, which kith no longer offers' <<< "$DOC")" 1
exit $((fails > 0))
