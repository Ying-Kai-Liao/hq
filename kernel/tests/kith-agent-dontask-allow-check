#!/usr/bin/env bash
# kith-agent-dontask-allow-check — `kith <agent> --launch-json` adds no allow rules of its own for the owner's run
# beyond the memory/skills Edit list: nothing from capabilities.yaml `tools:` and no read of the agent's own folder.
# The role's settings.json allow/deny rules pass through, every deny rule stays, and the mode reaches claude unchanged. Throwaway HOME and KITH_HOME; fake `claude` on PATH.
#
#   kernel/tests/kith-agent-dontask-allow-check     a few seconds; exits 1 when a check fails
set -uo pipefail

KERNEL="$(cd "$(dirname "$0")/.." && pwd)"
T=$(mktemp -d "${TMPDIR:-/tmp}/kith-dontask-allow-check.XXXXXX")
T=$(cd "$T" && pwd -P)
trap 'rm -rf "$T"' EXIT
export HOME=$T/home KITH_HOME="$T/real root" KITH_AUTH=$T/auth.json
unset KITH_STATE HQ_STATE KITH_PROJECT KITH_PERSON KITH_AGENT KITH_CLAUDE_ARGS KITH_HARNESS KITH_PERMISSION_MODE CLAUDE_CONFIG_DIR CODEX_HOME HQ_HOME
mkdir -p "$HOME" "$T/bin" "$T/state/projects"
export KITH_STATE=$T/state
mkagent() {   # name, capabilities.yaml text ("" for none)
  mkdir -p "$KITH_HOME/agents/$1/role"
  printf -- '---\nname: %s\ndescription: test agent\n---\nYou work.\n' "$1" > "$KITH_HOME/agents/$1/role/agent.md"
  printf '{"permissions":{"deny":["Read(~/.codex/auth.json)"],"allow":["Bash(echo:*)"]}}' > "$KITH_HOME/agents/$1/role/settings.json"
  [ -n "$2" ] && printf '%s\n' "$2" > "$KITH_HOME/agents/$1/role/capabilities.yaml"
  return 0
}
mkagent plain ""
mkagent artist "tools: [image-generation, artifacts, browser]"
mkagent blocky "tools:
  - infographic             # headless Chrome
  - render
  - img (local)"
mkagent unk "tools: [mystery]"
mkdir -p "$HOME/kith/agents" && ln -s "$KITH_HOME/agents/artist" "$HOME/kith/agents/artist"
printf '#!/bin/sh\n[ "$1 $2" = "plugin list" ] && echo "[]"\nexit 0\n' > "$T/bin/claude"; chmod +x "$T/bin/claude"
export PATH=$T/bin:$PATH

KITH=$KERNEL/bin/kith
fails=0
expect() { if [ "$2" = "$3" ]; then echo "ok   $1"; else echo "FAIL $1 (got $2, want $3)"; fails=$((fails + 1)); fi; }
# rules KIND AGENT: permissions.KIND of a launch-json run, one rule per line.
rules() { (cd "$KITH_HOME/agents/$2" && "$KITH" "$2" --launch-json 2>/dev/null) | KIND=$1 python3 -c '
import json,os,sys
j=json.load(sys.stdin)
s=j.get("settings") or {}
if isinstance(s,str): s=json.load(open(s))
print("\n".join(s.get("permissions",{}).get(os.environ["KIND"],[])))'; }
n() { grep -cxF -- "$1" <<< "$OUT"; }

home=$KITH_HOME/agents/artist
OUT=$(rules allow artist)
[ -n "$OUT" ] || { echo "FAIL no allow rules found in launch-json"; exit 1; }
expect "role's own allow kept" "$(n 'Bash(echo:*)')" 1
expect "Edit memory/ still allowed (one-shot runs save memory)" "$(n "Edit(/$home/memory/**)")" 1
expect "no Read of own folder" "$(grep -c '^Read(' <<< "$OUT")" 0
for sub in data files; do expect "no Edit of $sub/" "$(n "Edit(/$home/$sub/**)")" 0; done
expect "tools: artifacts approves nothing" "$(grep -c 'Artifact' <<< "$OUT")" 0
expect "tools: browser approves nothing" "$(grep -c 'Chrome' <<< "$OUT")" 0
expect "tools: render approves nothing" "$(grep -c 'python3' <<< "$OUT")" 0
expect "no duplicate rules" "$(sort <<< "$OUT" | uniq -d | wc -l | tr -d ' ')" 0
OUT=$(rules deny artist)
expect "role's deny kept" "$(n 'Read(~/.codex/auth.json)')" 1
expect "secrets deny kept" "$(grep -c 'secrets/\*\*' <<< "$OUT")" 2
OUT=$(rules allow blocky)
expect "block list tools: no Chrome" "$(grep -c 'Chrome' <<< "$OUT")" 0
# The mode: a stored 'manual' reads as default; the six built-in modes pass through; manual is refused on set.
mkdir -p "$KITH_HOME/machine"
SETTINGS=$(python3 "$KERNEL/lib/kith_paths.py" --sh | sed -n 's/^export KITH_MACHINE=//p' | tr -d "'\"")
mkdir -p "$SETTINGS"
printf '{"permission_mode":"manual","agents":{"plain":{"permission_mode":"manual"},"unk":{"permission_mode":"plan"}}}' > "$SETTINGS/settings.json"
expect "stored manual (global) reads as default" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode)" default
expect "stored manual (agent) reads as default" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode plain)" default
expect "other agent's mode kept" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode unk)" plan
python3 "$KERNEL/lib/kith_settings.py" set permission_mode plain manual >/dev/null 2>&1
expect "set manual is refused" "$?" 1
for m in default acceptEdits plan auto dontAsk bypassPermissions; do
  python3 "$KERNEL/lib/kith_settings.py" set permission_mode plain $m >/dev/null 2>&1
  expect "mode $m accepted and read back" "$(python3 "$KERNEL/lib/kith_settings.py" permission_mode plain)" $m
done
exit $((fails > 0))
