#!/usr/bin/env python3
"""hq-state — commit what hq and its agents have lived: two private repos, plus each agent's role.

  hq-state path      print the state folder (~/.hq; lib/hq_paths.py)
  hq-state dump      write every agent's data/*.db as a text dump next to it (<name>.sql), for git
  hq-state commit    dump, then commit and push (when there is a remote) the state folder (hq's knowledge: user.md,
                     projects, agents.json, rules) and the agents folder (each agent's memory and data; role/ and
                     files/ are not in it); then commit and push every agent's role repo (hq-pkg push --all)

Databases are committed as dumps, not binaries: they diff, merge by hand, and restore with
`sqlite3 NEW.db < NAME.sql`. The state repo holds personal data; keep its remote private.
"""
import datetime as dt
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

HQ = Path(os.environ.get('HQ_ROOT') or os.path.dirname(os.path.dirname(
    os.path.normpath(os.path.join(os.environ.get('PWD') or os.getcwd(), sys.argv[0])))))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from hq_paths import paths  # noqa: E402  the one place that knows where hq's folders are
STATE, AGENTS = paths()['HQ_STATE'], paths()['HQ_AGENTS']


def dump():
    n = 0
    dbs = {p.resolve(): p for p in [*AGENTS.glob('*/data/*.db'), *STATE.glob('agents/*/data/*.db')]}
    for db in sorted(dbs.values()):
        out = db.with_suffix('.sql')
        src = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
        snap = sqlite3.connect(':memory:')
        src.backup(snap)                        # a consistent copy even while a tool is writing
        src.close()
        tmp = out.with_name(f'.{out.name}.tmp')
        with open(tmp, 'w') as f:
            for line in snap.iterdump():
                f.write(line + '\n')
        snap.close()
        tmp.replace(out)
        n += 1
        print(f'dumped {db.parent.parent.name}/data/{db.name} -> {out.name}')
    return n


def git(repo, *args, check=True):
    return subprocess.run(['git', *args], cwd=repo, capture_output=True, text=True, check=check)


def commit_repo(repo, label):
    if not (repo / '.git').exists():
        print(f'hq-state: {repo} is not a git repo; skipped')
        return
    git(repo, 'add', '-A')
    if git(repo, 'diff', '--cached', '--quiet', check=False).returncode == 0:
        print(f'hq-state: {label}: nothing changed')
        return
    r = git(repo, 'commit', '-q', '-m', f'{label}: {dt.datetime.now():%Y-%m-%d %H:%M}', check=False)
    if r.returncode:
        print(f'hq-state: {label}: commit failed: {(r.stderr or r.stdout).strip().splitlines()[-1]}', file=sys.stderr)
        return
    print(f'hq-state: {label}: committed')
    if git(repo, 'remote', check=False).stdout.strip():
        r = git(repo, 'push', '-q', check=False)
        print(f'hq-state: {label}: pushed' if r.returncode == 0 else f'hq-state: {label}: push failed: {r.stderr.strip()}')


def commit():
    # which agents this install has, and their links, so another Mac can install them (hq-pkg install --saved)
    subprocess.run([str(HQ / 'bin' / 'hq-pkg'), 'save'], env=os.environ)
    dump()
    commit_repo(STATE, 'state')
    if AGENTS.resolve() != STATE.resolve() and (AGENTS / '.git').exists():
        commit_repo(AGENTS, 'agents')


def push_agents():
    """Each agent's role is its own repo (ignored by both): commit and push each one along with the rest."""
    subprocess.run([str(HQ / 'bin' / 'hq-pkg'), 'push', '--all'], env=os.environ)


def main(argv):
    cmd = argv[0] if argv else '-h'
    if cmd == 'path':
        print(STATE)
    elif cmd == 'dump':
        dump()
    elif cmd == 'commit':
        commit()
        push_agents()
    else:
        print(__doc__.strip())
        return 0 if cmd in ('-h', '--help') else 2
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
