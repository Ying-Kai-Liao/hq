#!/usr/bin/env python3
"""hq-live — reach an agent that runs as one long-lived session (`session: live` in its agent.md, e.g. coder).

  hq-live is <agent>                    exit 0 when the agent is a live agent
  hq-live start <agent> [orca|tmux|here] [--dry-run]
                                        start its session in the agent's home: an Orca tab, a tmux session
                                        "hq-<agent>", or this terminal; no mode: orca if it answers, else tmux, else
                                        here. Never a second one where one runs
  hq-live where <agent>                 where its session runs: "orca <terminal handle>" or "tmux <session>";
                                        exit 1 when none is running
  hq-live send <agent> --reply TARGET [--from FROM] [--project ID] [--id ID] [--] TEXT
                                        type one message into the session: a header the agent trusts, then TEXT;
                                        prints the message id; exit 1 when no session runs, 2 when it refused

A live session is found from its own process, however it was started: the interactive Claude Code session running
the agent's prompt, and the Orca pane (ORCA_AGENT_PANE) or tmux pane (TMUX_PANE) it runs in. Fallbacks: an Orca tab
titled "hq <agent>", a tmux session "hq-<agent>". A plain terminal can't be reached: start it in Orca or tmux.

The header is written here, never by the sender: `[hq id=<id> from=<from> reply=<target> project=<ID>]`. FROM is
owner (default) or agent:<name>; the bridge resolves the person first and sends only the owner's messages.
TARGET says where the agent answers with `hq-send --to TARGET` (ask:<id>, bridge:<box>, dm); see hq-send.
TEXT goes on one line (newlines become " / ") and any "[hq " in it is defused, so a message can't forge a header.
Delivery types the text as a person would; it never starts a run or sets a permission mode.
"""
import json, os, re, secrets, shlex, shutil, subprocess, sys, time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
from hq_paths import paths  # noqa: E402

P = paths()


def card(agent):
    for pkg in (P['HQ_AGENTS'] / agent / 'role', P['HQ_AGENTS'] / agent):
        f = pkg / 'agent.md'
        if f.is_file():
            m = re.match(r'^---\n(.*?)\n---', f.read_text(), re.S)
            return m.group(1) if m else ''
    return None


def is_live(agent):
    head = card(agent)
    return bool(head and re.search(r'^session:\s*live\s*$', head, re.M))


def orca(*args):
    if not shutil.which('orca'):
        return None
    try:
        r = subprocess.run(['orca', *args, '--json'], capture_output=True, text=True, timeout=30)
        d = json.loads(r.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return d.get('result') if d.get('ok') else None


def sessions(agent):
    """Interactive Claude Code sessions running this agent's prompt (no -p): [(pid, env)], newest first."""
    out = subprocess.run(['ps', '-axo', 'pid=,tty=,lstart=,command='], capture_output=True, text=True).stdout
    mark, found = f'You are the `{agent}` agent', []
    for row in out.splitlines():
        m = re.match(r'\s*(\d+)\s+(\S+)\s+(\w+ \w+ +\d+ [\d:]+ \d+)\s+(.*)', row)
        if not m or m.group(2) in ('??', '-') or mark not in m.group(4):
            continue
        cmd = m.group(4)
        if not re.match(r'(\S*/)?claude\s', cmd) or re.search(r'\s-p\s', cmd):
            continue
        env = subprocess.run(['ps', 'eww', '-o', 'command=', '-p', m.group(1)], capture_output=True, text=True).stdout
        found.append((int(m.group(1)), dict(re.findall(r'\s(ORCA_AGENT_PANE|TMUX_PANE)=(\S+)', env))))
    return sorted(found, reverse=True)


def where(agent):
    """('orca', terminal handle) | ('tmux', pane or session) | None. Found from the session's own process: the Orca
    pane or tmux pane it runs in (Claude Code retitles its tab, so titles are only a fallback)."""
    terms = None
    for _, env in sessions(agent):
        if env.get('ORCA_AGENT_PANE'):
            terms = terms if terms is not None else (orca('terminal', 'list') or {}).get('terminals', [])
            for t in terms:
                pane = env['ORCA_AGENT_PANE']
                if pane in (t.get('recordedPaneKey'), f"{t.get('tabId')}:{t.get('leafId')}") and t.get('writable', True):
                    return 'orca', t['handle']
        if env.get('TMUX_PANE') and shutil.which('tmux'):
            return 'tmux', env['TMUX_PANE']
    for t in (orca('terminal', 'list') or {}).get('terminals', []) if terms is None else terms:
        if t.get('title') == f'hq {agent}' and t.get('writable', True):
            return 'orca', t['handle']
    name = f'hq-{agent}'
    if shutil.which('tmux') and subprocess.run(['tmux', 'has-session', '-t', name],
                                               capture_output=True).returncode == 0:
        return 'tmux', name
    return None


def life(agent):
    return P['HQ_AGENTS'] / agent


def start(agent, mode, dry):
    if not is_live(agent):
        sys.exit(f'hq-live: {agent} is not a live agent (no session: live in its agent.md)')
    at = where(agent)
    if at:
        print(f'{agent} already runs: {at[0]} {at[1]}'
              + (f' (orca terminal switch --terminal {at[1]})' if at[0] == 'orca' else f' (tmux attach -t {at[1]})'))
        return 0
    up = orca('terminal', 'list') is not None
    mode = mode or ('orca' if up else 'tmux' if shutil.which('tmux') else 'here')
    home = life(agent)
    hq = str(Path(__file__).resolve().parent / 'hq')
    cmd = f'cd {shlex.quote(str(home))} && {shlex.quote(hq)} {agent}'
    if mode == 'orca':
        if not up:
            sys.exit('hq-live: Orca does not answer (is it running?); use tmux or here')
        given = os.environ.get('HQ_LIVE_ORCA_WORKTREE')
        best, targets = '', {str(home), os.path.realpath(home)}
        for w in (orca('worktree', 'list') or {}).get('worktrees', []):
            p = (w.get('path') or '').rstrip('/')
            if p and any(t == p or t.startswith(p + '/') for t in targets) and len(p) > len(best):
                best = p
        sel = given or (f'path:{best}' if best else 'active')
        argv = ['orca', 'terminal', 'create', '--worktree', sel, '--title', f'hq {agent}', '--command', cmd]
        if dry:
            print(shlex.join(argv)); return 0
        r = orca(*argv[1:])
        if not r:
            sys.exit(f'hq-live: orca terminal create failed (worktree {sel}; HQ_LIVE_ORCA_WORKTREE picks another)')
        t = r.get('terminal', r)
        print(f'{agent} started in Orca: {t.get("handle")} (under {sel}); the first start asks to trust {home}')
    elif mode == 'tmux':
        if not shutil.which('tmux'):
            sys.exit('hq-live: tmux is not installed (brew install tmux); use orca or here')
        argv = ['tmux', 'new-session', '-d', '-s', f'hq-{agent}', '-c', str(home), cmd]
        if dry:
            print(shlex.join(argv)); return 0
        subprocess.run(argv, check=True)
        print(f'{agent} started in tmux: tmux attach -t hq-{agent}')
    elif mode == 'here':
        if dry:
            print(cmd); return 0
        os.chdir(home)
        os.execv(hq, [hq, agent])
    else:
        sys.exit(f'hq-live: mode is orca, tmux or here, not {mode!r}')
    return 0


def line(text):
    text = re.sub(r'\s*\n\s*', ' / ', text.strip())
    return re.sub(r'\[(\s*)hq(\s)', r'[\1hq·\2', text)


def send(agent, reply, sender, project, mid, text):
    if not re.fullmatch(r'owner|agent:[a-z0-9-]+', sender):
        sys.exit(f'hq-live: --from is owner or agent:<name>, not {sender!r}')
    if not re.fullmatch(r'[\w:.-]+', reply):
        sys.exit(f'hq-live: bad --reply target {reply!r}')
    if project and not re.fullmatch(r'[a-z0-9][a-z0-9._-]*', project):
        sys.exit(f'hq-live: bad project {project!r}')
    if mid and not re.fullmatch(r'[\w.-]+', mid):
        sys.exit(f'hq-live: bad --id {mid!r}')
    mid = mid or f'{time.strftime("%Y%m%d%H%M%S")}-{secrets.token_hex(3)}'
    head = f'[hq id={mid} from={sender} reply={reply}' + (f' project={project}' if project else '') + ']'
    msg = f'{head} {line(text)}'
    at = where(agent)
    if not at:
        print(f'hq-live: {agent} has no live session (an Orca terminal "hq {agent}" or tmux session "hq-{agent}")',
              file=sys.stderr)
        return 1
    kind, h = at
    if kind == 'orca':
        r = orca('terminal', 'send', '--terminal', h, '--text', msg, '--enter', '--wait-submit', '10')
        sent = (r or {}).get('send', {})
        if not sent.get('accepted'):
            print(f'hq-live: Orca did not take the message ({json.dumps(r)[:300]})', file=sys.stderr)
            return 2
    else:
        ok = subprocess.run(['tmux', 'send-keys', '-t', h, '-l', msg]).returncode == 0 and \
            subprocess.run(['tmux', 'send-keys', '-t', h, 'Enter']).returncode == 0
        if not ok:
            print(f'hq-live: tmux send-keys to {h} failed', file=sys.stderr)
            return 2
    print(mid)
    return 0


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip()); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == 'start' and rest:
        flags = [a for a in rest[1:] if a != '--dry-run']
        return start(rest[0], flags[0] if flags else '', len(flags) != len(rest[1:]))
    if cmd in ('is', 'where') and len(rest) == 1:
        if cmd == 'is':
            return 0 if is_live(rest[0]) else 1
        at = where(rest[0])
        if at:
            print(*at); return 0
        return 1
    if cmd == 'send' and rest:
        agent, opts, words, i = rest[0], {'--reply': '', '--from': 'owner', '--project': '', '--id': ''}, [], 1
        while i < len(rest):
            if rest[i] in opts and i + 1 < len(rest):
                opts[rest[i]] = rest[i + 1]; i += 2
            elif rest[i] == '--':
                words += rest[i + 1:]; break
            else:
                words.append(rest[i]); i += 1
        if not opts['--reply'] or not words:
            sys.exit('usage: hq-live send <agent> --reply TARGET [--from FROM] [--project ID] [--id ID] [--] TEXT')
        if not is_live(agent):
            sys.exit(f'hq-live: {agent} is not a live agent (no session: live in its agent.md)')
        return send(agent, opts['--reply'], opts['--from'], opts['--project'], opts['--id'], ' '.join(words))
    sys.exit(__doc__.strip())


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
