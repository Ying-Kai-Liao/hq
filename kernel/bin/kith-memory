#!/usr/bin/env python3
"""kith-memory — search what the agents have written down.

  kith-memory search <words> [--agent NAME | --all] [-n N]   ranked matches as path:line and the passage
  kith-memory ls [--agent NAME | --all]                      the memory files and their sizes
  kith-memory ls --agent NAME --json                         {dir, files: [{path, bytes, modified}]} for programs
  kith-memory search <words> --agent NAME --json [-n N]      {hits: [{path, line, snippet}]}, path relative to memory/

Searches the markdown in the state folder: an agent's memory/ (MEMORY.md, topic files, projects/, sessions/) and its
learned skills, plus what all agents share: user.md and projects/ (project maps, decisions). Inside a kith run
($KITH_AGENT set) the default is that agent and the shared files; from your terminal it is every agent. --agent picks one, --all every one.

The files stay the only copy: each search indexes them afresh in memory (SQLite FTS5, ranked by bm25), so nothing
goes stale and there is no index to commit. Passages are a heading or paragraph each. Words are ANDed; "a phrase"
in quotes, prefix*, OR and NOT work as in FTS5. When the words match nothing, it falls back to a plain substring
search, which also finds text FTS doesn't split into words (Chinese, for one).

In a run for someone other than the owner (KITH_PERSON, checked with kith-auth) it searches only that agent's shared
memory and theirs (memory/shared/, memory/people/<id>/), its learned skills, their people/<id>.md and the current
project's shared files: never user.md, the owner's memory, other people, other agents, --agent or --all.
"""
import datetime as dt, json, os, re, sqlite3, subprocess, sys
from pathlib import Path

KITH = Path(__file__).resolve().parent.parent
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from kith_paths import paths  # noqa: E402  the one place that knows where kith's folders are
STATE = paths()['KITH_STATE']


def lives():
    """{agent: its life folder}: <kith>/agents/<name> next to role/, else <state>/agents/<name> (older layouts)."""
    out = {}
    agents = paths()['KITH_AGENTS']
    for d in sorted(agents.iterdir()) if agents.is_dir() else []:
        if (d / 'role').is_dir():
            out[d.name] = d
    old = STATE / 'agents'
    for d in sorted(old.iterdir()) if old.is_dir() and not old.is_symlink() else []:
        if d.is_dir():
            out.setdefault(d.name, d)
    return out


def files(scope, guest=None):
    """(label, path) for every markdown file in scope: agents' memory and learned skills, then the shared files.
    guest: the id of a person other than the owner the run is for: their part of the memory and only the current
    project's shared files."""
    for n, home in lives().items():
        if scope is not None and n != scope:
            continue
        subs = ('memory/shared', f'memory/people/{guest}') if guest else ('memory',)
        for sub in (*subs, 'skills/learned', 'role/skills/learned'):
            for f in sorted((home / sub).rglob('*.md')):
                yield n, f
    project = os.environ.get('KITH_PROJECT', '')
    shared = [STATE / 'user.md', *sorted((STATE / 'projects').rglob('*.md'))] if not guest else \
        [STATE / 'people' / f'{guest}.md',
         *(sorted((STATE / 'projects' / project).rglob('*.md')) if project and '/' not in project else [])]
    for f in shared:
        if f.is_file():
            yield 'shared', f


def listing(agent, guest=None):
    """{dir, files, total_bytes} for the agent's memory/ folder, for programs (ls --json, kith-info): paths relative
    to dir, markdown only like the search. A guest sees their own part only."""
    home = lives().get(agent)
    if home is None:
        raise ValueError('no agent %r' % agent)
    mem = home / 'memory'
    rows = []
    for _, f in files(agent, guest):
        try:
            rel, st = f.relative_to(mem), f.stat()
        except (ValueError, OSError):
            continue   # learned skills and shared files are searched, but are not memory/
        rows.append({'path': str(rel), 'bytes': st.st_size,
                     'modified': dt.datetime.fromtimestamp(st.st_mtime).astimezone().isoformat(timespec='seconds')})
    return {'dir': str(mem), 'files': rows, 'total_bytes': sum(r['bytes'] for r in rows)}


def guest_run():
    """The id of the person this runs for when that isn't the owner, else None. Fails closed: no answer from kith-auth
    is a person with no memory ('-')."""
    person = os.environ.get('KITH_PERSON')
    if not person:
        return None
    r = subprocess.run([str(KITH / 'bin' / 'kith-auth'), 'resolve', os.environ.get('KITH_AGENT') or '-', '--person', person],
                       capture_output=True, text=True)
    try:
        r = json.loads(r.stdout)
    except ValueError:
        return '-'
    pid = r.get('person') or '-'
    return None if r.get('owner') else pid if re.fullmatch(r'[a-z][a-z0-9-]*', pid) else '-'


def passages(path):
    """(first line number, text): split at headings and blank lines, so a hit points at the lines that matter."""
    chunk, start = [], 1
    for i, line in enumerate(path.read_text(errors='replace').splitlines(), 1):
        if (not line.strip() or line.startswith('#')) and any(c.strip() for c in chunk):
            yield start, '\n'.join(chunk).strip()
            chunk = []
        if not chunk:
            start = i
        if line.strip() or chunk:
            chunk.append(line)
    if any(c.strip() for c in chunk):
        yield start, '\n'.join(chunk).strip()


def fts_query(words):
    """User words → an FTS5 query. Plain words are quoted (so '-' or ':' don't break it); FTS syntax passes through."""
    if re.search(r'["*]|\b(AND|OR|NOT|NEAR)\b', words):
        return words
    return ' '.join('"%s"' % w.replace('"', '""') for w in words.split())


def search(words, scope, limit, guest=None):
    db = sqlite3.connect(':memory:')
    db.execute("create virtual table p using fts5(agent unindexed, path unindexed, line unindexed, text, "
               "tokenize='porter unicode61 remove_diacritics 2')")
    rows = [(a, str(f), n, t) for a, f in files(scope, guest) for n, t in passages(f)]
    db.executemany('insert into p values (?, ?, ?, ?)', rows)
    try:
        hits = db.execute("select agent, path, line, snippet(p, 3, '»', '«', ' … ', 24) from p where p match ? "
                          "order by bm25(p) limit ?", (fts_query(words), limit)).fetchall()
    except sqlite3.OperationalError as e:
        sys.exit('kith-memory: bad query %r: %s' % (words, e))
    if not hits:  # substring fallback: every word must appear
        ws = [w.lower() for w in words.split()]
        hits = [(a, p, n, t if len(t) < 300 else t[:300] + ' …') for a, p, n, t in rows
                if all(w in t.lower() for w in ws)][:limit]
    return hits, len(rows)


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__.strip()); return
    cmd, rest = argv[0], argv[1:]
    scope, limit, words, as_json = os.environ.get('KITH_AGENT') or None, 10, [], False
    own = scope
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == '--agent': scope = rest[i + 1]; i += 2
        elif a == '--all': scope = None; own = None; i += 1
        elif a == '-n': limit = int(rest[i + 1]); i += 2
        elif a == '--json': as_json = True; i += 1
        else: words.append(a); i += 1
    guest = guest_run()
    if guest:   # their own agent's memory only, whatever they asked for
        if not own:
            sys.exit('kith-memory: a run for someone other than the owner searches its own agent only')
        scope = own
    if as_json and cmd == 'ls':
        if not scope or scope not in lives():
            sys.exit('kith-memory: ls --json needs --agent NAME of an installed agent')
        out = listing(scope, guest)
        print(json.dumps({'dir': out['dir'], 'files': out['files']}))
        return
    if cmd == 'ls':
        for a, f in files(scope, guest):
            print('%-10s %6d  %s' % (a, f.stat().st_size, f))
        return
    if cmd != 'search' or not words:
        sys.exit('usage: kith-memory search <words> [--agent NAME | --all] [-n N]')
    if scope and scope not in lives():
        sys.exit('kith-memory: no agent %r' % scope)
    hits, n = search(' '.join(words), scope, limit, guest)
    if as_json:   # paths relative to the agent's memory/ when inside it, else absolute (learned skills, shared files)
        def rel(a, p):
            mem = lives().get(a)
            try:
                return str(Path(p).relative_to(mem / 'memory')) if mem else p
            except ValueError:
                return p
        print(json.dumps({'hits': [{'path': rel(a, p), 'line': line, 'snippet': ' '.join(t.split())[:400]}
                                   for a, p, line, t in hits]}, ensure_ascii=False))
        return
    where = 'every agent' if scope is None else scope
    if not hits:
        print('no matches in %d passages (%s and shared)%s' % (n, where, '; try --all' if own and not guest else '')); return
    home = str(Path.home())
    for a, p, line, text in hits:
        print('%s:%s  [%s]' % (p.replace(home, '~', 1), line, a))
        print('    ' + ' '.join(text.split())[:400])


if __name__ == '__main__':
    main(sys.argv[1:])
