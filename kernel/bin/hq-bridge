#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["discord.py>=2.4,<3"]
# ///
"""hq-bridge — talk to hq agents from Discord. One bot, one channel per agent, one thread per task.

  hq-bridge            run the bridge (foreground; launchd keeps it alive with --install)
  hq-bridge --install  install the macOS LaunchAgent so it starts at login and restarts if it dies
  hq-bridge --status   show channels and open threads
  hq-bridge --launcher copy uv to ~/.hq/bin/hq-uv; give that file Full Disk Access once, then --install

A message in #<agent> starts a thread and runs `hq <agent> "<message>"`; that agent owns the task. It may call
other agents as helpers; they post status in the same thread through `hq-send --as <name>`. Replies in a thread
resume the same Claude session. Messages sent while the agent is still working wait in the thread's inbox and go to
it together as one prompt when the run ends. With a Jev key (the jev-browser key, granted to `bridge` in hq-auth) each of those
messages is routed by Jev first: "stop" kills the run, a correction stops it and starts it again with the correction
merged in, a different subject becomes its own turn, anything else is merged; without Jev, or when Jev fails, it is
merged. While a run goes, the agent shows a small "working…" line with a Stop button; it goes away when the reply is
posted. Only the owner's (and allowed users') messages are acted on,
unless HQ_DISCORD_REPLY_TO=anyone.

Config (env or ~/.hq/secrets/env): HQ_DISCORD_BOT_TOKEN (required), HQ_DISCORD_OWNER_ID (your Discord user ID;
default: the server owner), HQ_DISCORD_GUILD (server name or ID; default: the bot's only server),
HQ_BRIDGE_PERMISSION_MODE (the permission mode for agent runs, on any harness; default bypassPermissions),
HQ_DISCORD_ALLOWED_IDS (comma-separated Discord user IDs answered besides the owner),
HQ_DISCORD_REPLY_TO (owner or anyone; default owner. anyone lets every member of the server run agents with that
permission mode, so use it only on a private server you trust), HQ_BRIDGE_DEBOUNCE (seconds to wait for more
messages before a run starts; default 2), HQ_BRIDGE_ROUTER (jev or off; default jev when a Jev key is found), HQ_BRIDGE_INTERRUPT (off: corrections wait
for the next turn instead of restarting the run), HQ_BRIDGE_CONTEXT_SHOW (a reply ends with a small "context N%" line once
the thread's session is at least this full, in percent; default 30, off to never show it).
State: ~/.hq/bridge/ (webhooks, thread → session map, downloaded attachments). Log: ~/.hq/logs/bridge.log.
"""
import asyncio
import json
import os
import re
import signal
import subprocess
import sys
import urllib.request
from pathlib import Path

HQ = Path(__file__).resolve().parent.parent
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from hq_paths import paths  # noqa: E402  the one place that knows where hq's folders are
STATE_DIR = paths()['HQ_MACHINE'] / 'bridge'
STATE = STATE_DIR / 'state.json'
LABEL = 'dev.hq.bridge'
# launchd can't read the external SSD without Full Disk Access; grant it to this fixed copy of uv, not the
# versioned Homebrew path that `brew upgrade uv` replaces
LAUNCHER = paths()['HQ_MACHINE'] / 'bin' / 'hq-uv'

STATE_ROOT, AGENTS = paths()['HQ_STATE'], paths()['HQ_AGENTS']  # <home>/state, <home>/agents
LOG = paths()['HQ_LOGS'] / 'bridge.log'


def agent_dirs():
    out = {}
    for root in (AGENTS, HQ / 'agents'):
        for d in sorted(root.iterdir()) if root.is_dir() else []:
            pkg = d / 'role' if (d / 'role' / 'agent.md').is_file() else d   # role/ next to the agent's life
            if not d.name.startswith('.') and (pkg / 'agent.md').is_file():
                out.setdefault(d.name, pkg)
    return out


def load_env():
    f = paths()['HQ_SECRETS'] / 'env'
    if f.exists():
        for line in f.read_text().splitlines():
            k, sep, v = line.strip().partition('=')
            # only hq's own settings: everything here is inherited by the agent runs the bridge starts, and the
            # file also holds things for other tools (CLAUDE_CODE_OAUTH_TOKEN is for hq-remote's runs only)
            if sep and k.strip().startswith('HQ_'):
                os.environ.setdefault(k.strip(), v.strip().strip('"\''))


def agents():
    return sorted(agent_dirs())


def description(agent):
    m = re.search(r'^description:\s*(.+)$', (agent_dirs()[agent] / 'agent.md').read_text(), re.M)
    return (m.group(1) if m else f'hq {agent}')[:1024]


def display_name(agent):
    m = re.search(r'^display_name:\s*(.+)$', (agent_dirs()[agent] / 'agent.md').read_text(), re.M)
    return m.group(1).strip() if m else agent


def read_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return {'webhooks': {}, 'threads': {}}


def write_state(st):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix('.tmp')
    tmp.write_text(json.dumps(st, indent=2))
    tmp.replace(STATE)


def launcher():
    import shutil
    uv = shutil.which('uv')
    if not uv:
        sys.exit('uv not found on PATH')
    LAUNCHER.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(os.path.realpath(uv), LAUNCHER)
    print(f'copied {os.path.realpath(uv)} → {LAUNCHER}\n'
          f'Grant it Full Disk Access (System Settings → Privacy & Security → Full Disk Access → +, Cmd+Shift+G, '
          f'paste the path), then run hq-bridge --install. A new copy needs granting again.')


def install():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    me = paths()['HQ_HOME'] / 'kernel' / 'bin' / 'hq-bridge'   # the address, not the disk path: the hq folder can move
    argv = [LAUNCHER, 'run', '--quiet', '--script', me] if LAUNCHER.exists() else [me]
    args = ''.join(f'<string>{a}</string>' for a in argv)
    plist = Path.home() / 'Library' / 'LaunchAgents' / f'{LABEL}.plist'
    path = f"{Path.home()}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
    plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{LABEL}</string>
  <key>ProgramArguments</key><array>{args}</array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{path}</string><key>HOME</key><string>{Path.home()}</string></dict>
  <key>WorkingDirectory</key><string>{Path.home()}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>{LOG}</string>
  <key>StandardErrorPath</key><string>{LOG}</string>
</dict></plist>
""")
    os.system(f'launchctl bootout gui/{os.getuid()}/{LABEL} 2>/dev/null; launchctl bootstrap gui/{os.getuid()} "{plist}"')
    print(f'installed {plist}; logs in {LOG}')


def jev_config():
    """JEV_* from the environment, the key from hq-auth (hq-auth grant bridge jev-browser <profile>); kept out of
    os.environ so agent runs never see the key."""
    cfg = {k: v for k, v in os.environ.items() if k.startswith('JEV_')}
    if 'JEV_API_KEY' not in cfg:
        r = subprocess.run([str(HQ / 'bin' / 'hq-auth'), 'get', '--for', 'bridge', 'jev-browser', 'TYPESAFE_API_KEY'],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            cfg['JEV_API_KEY'] = r.stdout.strip()
    return cfg


# Narrow yes/no questions (Jev ignores negation inside a question); thresholds from probes on 2026-10-16.
ROUTE_QUESTIONS = {
    'stop': 'Does `latest` ask the assistant to stop, cancel or abort the work in `task`?',
    'change': 'Does `latest` replace or correct an instruction given in `task`?',
    'add': 'Does `latest` add a detail or an extra request to the work in `task`?',
    'other': 'Is `latest` a request about a different subject from `task`?',
    'partial': 'Does `latest` end mid-thought, as if the user will send the rest in a next message?',
}


def route(cfg, task, recent, latest):
    """-> (stop | separate | merge, path) for a message that arrived while `task` runs. Any failure merges."""
    if not cfg.get('JEV_API_KEY') or os.environ.get('HQ_BRIDGE_ROUTER', 'jev').lower() == 'off':
        return 'merge', 'no router'
    base = cfg.get('JEV_BASE_URL', 'https://api.typesafe.ai').rstrip('/')
    url = base if base.endswith('/systemone') else base + ('/systemone' if base.endswith('/v1') else '/v1/systemone')
    body = json.dumps({'model': cfg.get('JEV_MODEL', 'jev-latest'),
                       'state': {'task': task[-4000:], 'recent': recent[-6:], 'latest': latest[-2000:]},
                       'questions': {k: {'type': 'noul', 'instructions': q} for k, q in ROUTE_QUESTIONS.items()}},
                      ensure_ascii=False).encode()
    req = urllib.request.Request(url, data=body, method='POST', headers={
        'Authorization': 'Bearer ' + cfg['JEV_API_KEY'], 'Content-Type': 'application/json', 'User-Agent': 'hq-bridge'})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            ans = json.loads(r.read().decode())['answers']
        p = {k: max(0.0, min(1.0, float(ans[k]['noul']))) for k in ROUTE_QUESTIONS}
    except Exception as e:  # noqa: BLE001  the router is advice; the inbox works without it
        return 'merge', f'jev failed ({type(e).__name__})'
    path = ' '.join(f'{k}:{v:.2f}' for k, v in p.items())
    if p['stop'] >= 0.9 and p['stop'] > p['change']:   # "wait, do August instead" scores stop 0.80, change 0.96
        return 'stop', path
    if p['change'] >= 0.9 and os.environ.get('HQ_BRIDGE_INTERRUPT', 'on').lower() != 'off':
        return 'interrupt', path   # "actually make it sushi", "do August instead": the running work is off course
    if p['other'] >= 0.9 and p['add'] < 0.7 and p['change'] < 0.5:   # "make it sushi": other 0.93 but change 0.95
        return 'separate', path
    return ('merge-partial' if p['partial'] >= 0.8 else 'merge'), path


INTERRUPTED = ('(Your previous attempt at this was stopped part-way because the user corrected it; files or other '
               'things it touched may be half-changed, so check before you go on.)\n\n')


def merged(items):
    if len(items) == 1:
        return items[0]
    return ('The user sent several messages in a row; answer them together, in one reply:\n\n'
            + '\n\n'.join(f'[{i}] {t}' for i, t in enumerate(items, 1)))


def context_pct(res):
    """How full the session's context is after this turn, in percent; None when the result doesn't say."""
    its = (res.get('usage') or {}).get('iterations') or []
    models = [m for m in (res.get('modelUsage') or {}).values() if m.get('contextWindow')]
    if not its or not models:
        return None
    last = its[-1]   # the turn's final API call: what the next turn starts from
    used = sum(last.get(k, 0) for k in ('input_tokens', 'cache_read_input_tokens', 'cache_creation_input_tokens',
                                        'output_tokens'))
    main = max(models, key=lambda m: m.get('inputTokens', 0) + m.get('cacheReadInputTokens', 0)
               + m.get('cacheCreationInputTokens', 0))   # the agent's own model, not a helper's
    return 100 * used / main['contextWindow']


def chunks(text, n=1900):
    text = text.strip() or '(no reply)'
    while text:
        cut = text.rfind('\n', 0, n) if len(text) > n else len(text)
        cut = cut if cut > n // 2 else min(n, len(text))
        yield text[:cut]
        text = text[cut:].lstrip('\n')


def main():
    load_env()
    if '--launcher' in sys.argv:
        return launcher()
    if '--install' in sys.argv:
        return install()
    if '--status' in sys.argv:
        st = read_state()
        print(json.dumps({'channels': sorted(st['webhooks']), 'threads': st['threads']}, indent=2))
        return
    token = os.environ.get('HQ_DISCORD_BOT_TOKEN')
    if not token:
        sys.exit(f"hq-bridge: set HQ_DISCORD_BOT_TOKEN in {paths()['HQ_SECRETS'] / 'env'}")

    import discord

    intents = discord.Intents.default()
    intents.message_content = True
    client = discord.Client(intents=intents)
    WORKING, STOPPED = '-# working…', '-# stopped'   # Discord subtext: small and grey
    FOOTER = ('\n\n(From Discord: this thread is your task. Your final answer is posted here automatically; use '
              'hq-send for images and files. Helpers you call post status with `hq-send --as <their name>`.)')
    st = read_state()
    inbox: dict[str, list[list[str]]] = {k: v['batches'] for k, v in st.get('inbox', {}).items()}  # thread → batches
    busy: dict[str, dict] = {}       # thread → the running turn: agent, task, proc, stopped, hold
    history: dict[str, list] = {}    # thread → the last user messages, for the router
    jev = jev_config()
    hooks: dict[str, discord.Webhook] = {}
    owner_id = int(os.environ['HQ_DISCORD_OWNER_ID']) if os.environ.get('HQ_DISCORD_OWNER_ID') else None
    try:   # show a reply's context use from this %; off (or anything not a number) never shows it
        ctx_show = float(os.environ.get('HQ_BRIDGE_CONTEXT_SHOW', '30').strip().rstrip('%'))
    except ValueError:
        ctx_show = None
    anyone = os.environ.get('HQ_DISCORD_REPLY_TO', 'owner').strip().lower() == 'anyone'
    allowed = {int(x) for x in re.findall(r'\d+', os.environ.get('HQ_DISCORD_ALLOWED_IDS', ''))}

    async def setup(guild):
        nonlocal owner_id
        owner_id = owner_id or guild.owner_id
        category = discord.utils.get(guild.categories, name='hq') or await guild.create_category('hq')
        for agent in agents():
            ch = discord.utils.get(guild.text_channels, name=agent)
            if ch is None:
                ch = await guild.create_text_channel(agent, category=category, topic=description(agent))
            wh = next((w for w in await ch.webhooks() if w.name == 'hq'), None) or await ch.create_webhook(name='hq')
            st['webhooks'][agent] = {'channel_id': ch.id, 'url': wh.url}
            hooks[agent] = discord.Webhook.from_url(wh.url, client=client)
        write_state(st)
        print(f'hq-bridge: ready in {guild.name}: {", ".join(agents())}; acting on messages from {"anyone" if anyone else f"users {sorted({owner_id} | allowed)}"}', flush=True)

    @client.event
    async def on_ready():
        squash = lambda x: re.sub(r'\s+', '', x).lower()
        want = squash(os.environ.get('HQ_DISCORD_GUILD', ''))
        guilds = [g for g in client.guilds if not want or want in (squash(g.name), str(g.id))]
        if len(guilds) != 1:
            print(f'hq-bridge: expected one server, found {[g.name for g in client.guilds]}; set HQ_DISCORD_GUILD', flush=True)
            await client.close()
            return
        await setup(guilds[0])
        for key, saved in list(st.get('inbox', {}).items()):   # messages that waited when the bridge last stopped
            if key not in busy and saved.get('agent') in hooks:
                try:
                    asyncio.create_task(worker(saved['agent'], await client.fetch_channel(int(key))))
                except Exception as e:  # noqa: BLE001
                    print(f'hq-bridge: could not resume inbox {key}: {e}', flush=True)
        if not getattr(client, 'rescanning', False):  # on_ready fires again after reconnects
            client.rescanning = True
            asyncio.create_task(rescan(guilds[0]))

    async def rescan(guild):
        # New agents (from the builder or hq-new) get their channel within a minute, no restart needed.
        while True:
            await asyncio.sleep(60)
            try:
                if set(agents()) - set(st['webhooks']):
                    await setup(guild)
            except Exception as e:  # a failed rescan must never take the bridge down
                print(f'hq-bridge: rescan failed: {e}', flush=True)

    def save_inbox(agent, key):
        if inbox.get(key):
            st.setdefault('inbox', {})[key] = {'agent': agent, 'batches': inbox[key]}
        else:
            st.setdefault('inbox', {}).pop(key, None)
        write_state(st)

    async def run(agent, thread, task):
        """One agent turn in this thread; -> 'stopped', 'interrupted' or 'done'."""
        key = str(thread.id)
        session = st['threads'].get(key, {}).get('session_id')
        hook = st['webhooks'][agent]
        env = dict(os.environ, HQ_AGENT=agent, HQ_VIA='discord', HQ_DISCORD_WEBHOOK_URL=hook['url'], HQ_DISCORD_THREAD_ID=key,
                   HQ_OUTPUT='json', HQ_PERMISSION_MODE=os.environ.get('HQ_BRIDGE_PERMISSION_MODE', 'bypassPermissions'))
        if session:   # any harness: bin/hq starts a new session when this one is another harness's
            env['HQ_RESUME'] = session
        env.pop('HQ_DISCORD_BOT_TOKEN', None)  # agents never see the bot token
        for k in [k for k in env if k.startswith('JEV_')]:
            env.pop(k)                           # nor the router's key
        proc = await asyncio.create_subprocess_exec(
            str(HQ / 'bin' / 'hq'), agent, task + FOOTER, cwd=str(Path.home()), env=env, start_new_session=True,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
        busy[key]['proc'] = proc
        if busy[key].get('ended'):            # Stop was pressed before the process existed
            kill(proc)
        try:
            out, err = await asyncio.wait_for(proc.communicate(), timeout=3600)
        except asyncio.TimeoutError:
            kill(proc)
            out, err = b'', b'timed out after 60 min'
        if busy[key].get('ended'):
            return busy[key]['ended']
        try:
            res = json.loads(out.decode())
            text, sid = res.get('result') or '', res.get('session_id')
            if res.get('is_error'):
                text = f'⚠️ {text or res.get("subtype", "error")}'
            pct = context_pct(res)
            if pct is not None and ctx_show is not None and pct >= ctx_show:
                text += f'\n-# context {pct:.0f}%'
        except ValueError:
            text, sid = f'⚠️ {agent} failed:\n```\n{(err or out).decode(errors="replace")[-1500:]}\n```', None
        if sid:
            st['threads'][key] = {'agent': agent, 'session_id': sid}
            write_state(st)
        for part in chunks(text):
            await hooks[agent].send(part, username=display_name(agent), thread=thread, wait=True)
        return 'done'

    def kill(proc):
        try:
            os.killpg(proc.pid, signal.SIGTERM)  # hq → claude → its tools: the whole group
        except (ProcessLookupError, PermissionError):
            pass

    async def worker(agent, thread):
        """Drains the thread's inbox: each batch of merged messages is one turn. One worker per thread."""
        key = str(thread.id)
        busy[key] = {'agent': agent, 'task': ''}
        try:
            async with thread.typing():
                while inbox.get(key):
                    await asyncio.sleep(float(os.environ.get('HQ_BRIDGE_DEBOUNCE', '2')))
                    while busy[key].pop('hold', False):   # the last message looked unfinished: give the rest time
                        await asyncio.sleep(8)
                    if not inbox.get(key):                 # a "stop" came in during the wait
                        break
                    batch = inbox[key].pop(0)
                    busy[key]['cont'] = False    # whatever is queued now came in before this turn started
                    save_inbox(agent, key)
                    task = (INTERRUPTED if busy[key].pop('redo', False) else '') + merged(batch)
                    busy[key].update(task=task, batch=batch, ended=None, proc=None)
                    try:   # from the agent itself, as small grey text; the webhook is the bot's, so its button works
                        status = await hooks[agent].send(WORKING, username=display_name(agent), thread=thread,
                                                         view=stop_button(key), wait=True)
                    except Exception as e:  # noqa: BLE001  no button is fine: typing "stop" still works
                        print(f'hq-bridge: status message {key}: {e}', flush=True)
                        status = None
                    busy[key]['status'] = status
                    ended = await run(agent, thread, task)
                    busy[key]['status'] = None
                    try:
                        if ended == 'stopped' and status:
                            await status.edit(content=STOPPED, view=None)
                        elif ended == 'stopped':
                            await hooks[agent].send(STOPPED, username=display_name(agent), thread=thread, wait=True)
                        elif status:
                            await status.delete()
                    except Exception as e:  # noqa: BLE001
                        print(f'hq-bridge: status message {key}: {e}', flush=True)
        except Exception as e:  # noqa: BLE001  keep the inbox on disk; the next message or restart picks it up
            print(f'hq-bridge: worker {key} failed: {e}', flush=True)
        finally:
            busy.pop(key, None)

    async def deliver(agent, thread, msg, task):
        key = str(thread.id)
        recent = history.setdefault(key, [])
        q = inbox.setdefault(key, [])
        running = busy.get(key, {}).get('proc')
        running = running if running is not None and running.returncode is None else None
        if running is None:
            # Nothing running: the message joins the prompt about to go (or starts one) right away, so the run can't
            # leave without it while Jev answers; Jev is then only asked whether it says "stop".
            waiting = key in busy and bool(q)
            if q:
                q[-1].append(task)
            else:
                q.append([task])
            save_inbox(agent, key)
            if key not in busy:
                asyncio.create_task(worker(agent, thread))
                waiting = False
            if waiting:
                decision, path = await asyncio.to_thread(route, jev, merged(q[-1][:-1] or [task]), recent, msg.content)
                print(f'hq-bridge: route {key} {path} -> {decision} (waiting)', flush=True)
                if decision == 'merge-partial':
                    busy.get(key, {})['hold'] = True
                elif decision == 'stop':
                    await stop(agent, thread, key, msg)
            remember(recent, msg)
            return
        decision, path = await asyncio.to_thread(route, jev, busy[key]['task'], recent, msg.content)
        print(f'hq-bridge: route {key} {path} -> {decision}', flush=True)
        remember(recent, msg)
        now = busy.get(key, {})
        if decision == 'stop':
            await stop(agent, thread, key, msg)
            return
        if decision == 'interrupt' and now.get('proc') is running and running.returncode is None:
            now['ended'], now['redo'] = 'interrupted', True
            more = q.pop(0) if q and now.get('cont') else []   # extras for this same work that were waiting
            q.insert(0, now['batch'] + more + [task])          # the same work again, corrected, before anything else
            now['cont'] = False
            kill(running)
            save_inbox(agent, key)
            await react(msg, '🔁')
            if now.get('status') is not None:
                try:
                    await now['status'].edit(content='-# restarting with your correction…', view=None)
                except Exception:  # noqa: BLE001  cosmetic
                    pass
            return
        if decision == 'separate' or not q:
            q.append([task])
            if key in busy:
                now['cont'] = decision != 'separate' and len(q) == 1   # the next batch continues the running work
        else:
            q[-1].append(task)
        save_inbox(agent, key)
        if key in busy:
            now['hold'] = now.get('hold') or decision == 'merge-partial'
            await show_queued(key)
        else:
            asyncio.create_task(worker(agent, thread))   # the run ended while Jev answered

    async def react(msg, emoji):
        try:
            await msg.add_reaction(emoji)
        except Exception:  # noqa: BLE001  cosmetic
            pass

    def remember(recent, msg):
        recent.append({'role': 'user', 'text': msg.content[-1000:]})
        del recent[:-6]

    def stop_button(key):
        view = discord.ui.View(timeout=None)
        view.add_item(discord.ui.Button(label='Stop', style=discord.ButtonStyle.secondary,
                                        custom_id=f'hq-stop:{key}'))   # handled in on_interaction, so it survives restarts
        return view

    async def show_queued(key):
        """The working line says how many messages wait for the next turn (instead of a reaction on each)."""
        now = busy.get(key, {})
        n = sum(len(b) for b in inbox.get(key, []))
        if now.get('status') is not None:
            try:
                await now['status'].edit(content=WORKING + (f' · {n} queued' if n else ''))
            except Exception:  # noqa: BLE001  cosmetic
                pass

    @client.event
    async def on_interaction(it):
        cid = (it.data or {}).get('custom_id', '')
        if not cid.startswith('hq-stop:'):
            return
        if not anyone and it.user.id not in {owner_id} | allowed:
            return await it.response.send_message('Only the owner can stop this.', ephemeral=True)
        key = cid.split(':', 1)[1]
        now = busy.get(key)
        if now is None or (now.get('proc') is not None and now['proc'].returncode is not None):
            return await it.response.edit_message(content='-# finished', view=None)
        await it.response.edit_message(content='-# stopping…', view=None)
        print(f'hq-bridge: stop {key} pressed by {it.user.id}', flush=True)
        inbox[key] = []
        save_inbox(now['agent'], key)
        now['ended'] = 'stopped'
        if now.get('proc') is not None:
            kill(now['proc'])                # the worker turns "Stopping…" into "Stopped." when the run comes back

    async def stop(agent, thread, key, msg):
        """Empty the inbox and end the running turn, or the one about to start."""
        inbox[key] = []
        save_inbox(agent, key)
        now = busy.get(key, {})
        proc = now.get('proc')
        starting = proc is None and now.get('task')   # batch taken, process not started yet: run() kills it at once
        if starting or (proc is not None and proc.returncode is None):
            now['ended'] = 'stopped'
            if proc is not None:
                kill(proc)                   # the worker posts "Stopped." when the run comes back
        else:
            await hooks[agent].send(STOPPED, username=display_name(agent), thread=thread, wait=True)
        await react(msg, '🛑')   # only messages the bridge acted on get a reaction; queued ones are counted instead

    @client.event
    async def on_message(msg):
        if msg.author.bot or msg.webhook_id or (not anyone and msg.author.id not in {owner_id} | allowed):
            return
        if isinstance(msg.channel, discord.Thread) and msg.channel.parent and msg.channel.parent.name in st['webhooks']:
            agent, thread = msg.channel.parent.name, msg.channel
        elif getattr(msg.channel, 'name', None) in st['webhooks']:
            agent = msg.channel.name
            title = re.sub(r'\s+', ' ', msg.content).strip()[:90] or 'task'
            thread = await msg.create_thread(name=title, auto_archive_duration=1440)
        else:
            return
        task = msg.content
        if msg.attachments:
            folder = STATE_DIR / 'attachments' / str(thread.id)
            folder.mkdir(parents=True, exist_ok=True)
            paths = []
            for a in msg.attachments:
                p = folder / a.filename
                await a.save(p)
                paths.append(str(p))
            task += '\n\nAttached files: ' + ', '.join(paths)
        await deliver(agent, thread, msg, task)

    client.run(token, log_handler=None)


if __name__ == '__main__':
    main()
