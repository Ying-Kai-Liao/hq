#!/usr/bin/env python3
"""hq-acp — run an hq agent as an ACP agent (Agent Client Protocol), for clients like Codync.

  hq acp <agent> [--keep team,…]

Client -> this filter -> claude-agent-acp -> adapters/acp/claude-via-hq -> `hq <agent>` -> claude.

The filter drops what Codync adds to every session (its instructions in `_meta.systemPrompt` and its MCP servers:
memory, team, routines, connectors, chat), so the agent runs with hq's own prompt, tools and memory only. `--keep`
lets the named servers through (team, for bot-to-bot work). Codync's memory keeper (a summary run with a
plain-string system prompt) passes through and runs on plain claude, not as the agent.

One session per chat: Codync runs a bot's group turns in the bot's own session, so the bot's 1:1 chat and every
group share one context. Here each group gets its own agent session, made on its first turn and kept in
<machine>/acp/<agent>.json so a restart resumes it. The client never sees those sessions: their updates and
permission requests reach it under the session it prompted, and its model and option changes apply to them too.
Threads inside one group share the group's session (the prompt doesn't say which thread).

Logs: <logs>/acp/ (filter.log, args.jsonl, dropped-<agent>.json: what Codync would have given the bot)."""
import json, os, queue, re, subprocess, sys, threading, time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from hq_paths import paths  # noqa: E402  the one place that knows where hq's folders are

ADAPTER = os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'adapters', 'acp')
SESSION = {"session/new", "session/load", "session/fork", "session/resume"}
# Codync's room turn (chat/group.rs member_prompt): "You are X, one participant in a group chat (…" and a header line.
GROUP = re.compile(r'^\[Group chat: "(.+?)"(?:, in a thread)? - with ', re.M)
# Client settings that belong to a session; replayed onto the group sessions.
SETTINGS = {"session/set_model", "session/set_config_option", "session/set_mode"}


def group_of(prompt):
    """The group a session/prompt is a room turn in, or None for the bot's own chat."""
    text = "".join(b.get("text", "") for b in prompt if isinstance(b, dict) and b.get("type") == "text")
    if not text.startswith("You are ") or "one participant in a group chat" not in text.split("\n", 1)[0]:
        return None
    m = GROUP.search(text)
    return m and m.group(1)


class Filter:
    def __init__(self, agent, keep, agent_in, out, logs, lanes_file):
        self.agent, self.keep, self.agent_in, self.out = agent, keep, agent_in, out
        self.logs, self.lanes_file = logs, lanes_file
        # The client and the agent are each written from both threads: one lock per stream, so neither waits on the other.
        self.locks = {id(agent_in): threading.Lock(), id(out): threading.Lock()}
        self.ids = threading.Lock()
        self.lanes = self.load_lanes()        # {client session: {group: agent session}}
        self.alias = {s: c for c, g in self.lanes.items() for s in g.values()}  # agent session -> client session
        self.started = set()                  # group sessions made or loaded in this process
        self.params = {}                      # client session -> {cwd, mcpServers} it was opened with
        self.settings = {}                    # client session -> {(method, key): params} to replay
        self.pending = {}                     # client request id -> (method, params) awaiting a session id
        self.running = {}                     # client session -> the agent session its current prompt went to
        self.own = {}                         # our request id -> queue for its response
        self.muted = set()                    # group sessions being loaded: their replayed history isn't the client's
        self.making = 0                       # group session/new in flight: updates for unknown sessions are dropped
        self.next_id = 0

    # --- bookkeeping -------------------------------------------------------------------------------------------
    def note(self, what):
        with open(os.path.join(self.logs, "filter.log"), "a") as f:
            f.write(f"{time.strftime('%FT%T')} {self.agent} {what}\n")

    def load_lanes(self):
        try:
            with open(self.lanes_file) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_lanes(self):
        os.makedirs(os.path.dirname(self.lanes_file), exist_ok=True)
        tmp = self.lanes_file + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.lanes, f, indent=1)
        os.replace(tmp, self.lanes_file)

    def write(self, stream, msg):
        self.write_raw(stream, (json.dumps(msg) + "\n").encode())

    def write_raw(self, stream, data):
        with self.locks[id(stream)]:
            stream.write(data)
            stream.flush()

    def request(self, method, params):
        """Send our own request to the agent and wait for its answer (the reader thread delivers it)."""
        with self.ids:
            self.next_id += 1
            rid = f"hq-acp-{self.next_id}"
            self.own[rid] = queue.Queue()
        self.write(self.agent_in, {"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
        reply = self.own[rid].get()
        del self.own[rid]
        return reply

    # --- client -> agent ---------------------------------------------------------------------------------------
    def strip(self, msg):
        p = msg["params"]
        meta = p.get("_meta")
        if isinstance(meta, dict) and isinstance(meta.get("systemPrompt"), str):
            # The memory keeper: claude-via-hq sees this marker and runs plain claude.
            open(os.path.join(self.logs, f"keeper-{os.getpid()}"), "w").close()
            self.note(f"{msg['method']}: memory keeper, passed through")
            return
        servers = p.get("mcpServers") or []
        dropped = [s.get("name") for s in servers if s.get("name") not in self.keep]
        p["mcpServers"] = [s for s in servers if s.get("name") in self.keep]
        system = meta.pop("systemPrompt", None) if isinstance(meta, dict) else None
        if system is not None:
            dropped.append("systemPrompt")
        # Kept for study (Kai, 2026-10-19): what Codync would have given this bot.
        if servers or system is not None:
            with open(os.path.join(self.logs, f"dropped-{self.agent}.json"), "w") as f:
                json.dump({"t": time.strftime("%FT%T"), "method": msg["method"], "mcpServers": servers,
                           "systemPrompt": system}, f, indent=1)
        self.note(f"{msg['method']}: dropped {dropped}, kept {[s.get('name') for s in p['mcpServers']]}")

    def from_client(self, msg):
        method, p = msg.get("method"), msg.get("params")
        if not isinstance(p, dict):
            return msg
        if method in SESSION:
            self.strip(msg)
            opened = {"cwd": p.get("cwd"), "mcpServers": p.get("mcpServers", [])}
            if method in ("session/load", "session/resume") and p.get("sessionId"):
                self.params[p["sessionId"]] = opened
            elif "id" in msg:
                self.pending[msg["id"]] = opened
        elif method == "session/prompt":
            sid = p.get("sessionId")
            group = group_of(p.get("prompt") or [])
            target = self.lane(sid, group) if group else sid
            self.running[sid] = target
            if target != sid:
                p["sessionId"] = target
                self.note(f"session/prompt: group {group!r} -> its own session {target}")
        elif method == "session/cancel":
            sid = p.get("sessionId")
            p["sessionId"] = self.running.get(sid, sid)
        elif method in SETTINGS:
            sid = p.get("sessionId")
            key = (method, p.get("configId") or "")
            self.settings.setdefault(sid, {})[key] = p
            for target in (self.lanes.get(sid) or {}).values():
                if target in self.started:
                    self.request(method, dict(p, sessionId=target))
        return msg

    def lane(self, sid, group):
        """The agent session for `group` under client session `sid`: made on first use, loaded after a restart."""
        groups = self.lanes.setdefault(sid, {})
        target = groups.get(group)
        if target in self.started:
            return target
        opened = self.params.get(sid) or {"cwd": os.getcwd(), "mcpServers": []}
        if target:
            self.muted.add(target)
            reply = self.request("session/load", dict(opened, sessionId=target))
            self.muted.discard(target)
            if "error" in reply:
                self.note(f"group {group!r}: couldn't load {target} ({reply['error'].get('message')}), starting anew")
                target = None
        if not target:
            # Until the alias is set, updates for the session being made (not yet known) are dropped.
            self.making += 1
            reply = self.request("session/new", dict(opened))
            if "error" in reply:
                self.making -= 1
                self.note(f"group {group!r}: couldn't start a session ({reply['error'].get('message')}), using {sid}")
                return sid
            target = reply["result"]["sessionId"]
            groups[group] = target
            self.save_lanes()
            self.alias[target] = sid
            self.making -= 1
            self.note(f"group {group!r}: new session {target} for {sid}")
        self.started.add(target)
        for (method, _), params in (self.settings.get(sid) or {}).items():
            self.request(method, dict(params, sessionId=target))
        return target

    # --- agent -> client ---------------------------------------------------------------------------------------
    def from_agent(self, msg):
        """The message to pass on to the client, or None to keep it."""
        rid = msg.get("id")
        if "method" not in msg and rid in self.own:
            self.own[rid].put(msg)
            return None
        if "method" not in msg and rid in self.pending:
            opened = self.pending.pop(rid)
            sid = (msg.get("result") or {}).get("sessionId")
            if sid:
                self.params[sid] = opened
            return msg
        p = msg.get("params")
        sid = p.get("sessionId") if isinstance(p, dict) else None
        if sid is None:
            return msg
        if sid in self.muted:
            return None
        if sid in self.alias:
            p["sessionId"] = self.alias[sid]
        elif self.making and sid not in self.params and msg.get("method") == "session/update":
            return None
        return msg


def main():
    args = sys.argv[1:]
    keep = set()
    if len(args) == 3 and args[1] == "--keep":
        keep = set(args.pop().split(",")); args.pop()
    if len(args) != 1 or args[0].startswith("-"):
        sys.exit("usage: hq acp <agent> [--keep team,…]")
    agent = args[0]
    p = paths()
    logs = os.environ.setdefault("HQ_ACP_LOG", str(p["HQ_LOGS"] / "acp"))
    os.makedirs(logs, exist_ok=True)
    env = dict(os.environ, HQ_ACP_AGENT=agent, HQ_ACP_PID=str(os.getpid()),
               CLAUDE_CODE_EXECUTABLE=os.path.realpath(os.path.join(ADAPTER, "claude-via-hq")))
    proc = subprocess.Popen(["npx", "-y", "@agentclientprotocol/claude-agent-acp@0.93.0"], env=env,
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
    out = sys.stdout.buffer
    f = Filter(agent, keep, proc.stdin, out, logs, str(p["HQ_MACHINE"] / "acp" / f"{agent}.json"))

    def from_agent():
        for line in proc.stdout:
            try:
                msg = f.from_agent(json.loads(line))
            except ValueError:
                f.write_raw(out, line)
                continue
            if msg is not None:
                f.write(out, msg)

    def from_client():
        for line in sys.stdin.buffer:
            try:
                msg = f.from_client(json.loads(line))
            except ValueError:
                f.write_raw(proc.stdin, line)
                continue
            f.write(proc.stdin, msg)
        proc.stdin.close()

    threading.Thread(target=from_agent, daemon=True).start()
    threading.Thread(target=from_client, daemon=True).start()
    sys.exit(proc.wait())


if __name__ == "__main__":
    main()
