{
  "description": "Jev Browser MCP server: Google Maps lookups, login-walled pages, in the agent's browser profile",
  "kind": "mcp",
  "browsers": ["chrome", "chromium", "chrome-beta", "msedge", "path"],
  "mcp": {
    "command": "npx",
    "args": ["-y", "-p", "jev-browser@latest", "jev-browser-mcp"],
    "env": { "JEV_BROWSER": "$KITH_BROWSER", "JEV_BROWSER_PROFILE": "$KITH_BROWSER_PROFILE" }
  },
  "secrets": ["TYPESAFE_API_KEY"]
}
