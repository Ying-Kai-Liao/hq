{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "How an hq agent runs",
    "output": "how-hq-runs.html",
    "quality_profile": "showcase",
    "viewBox": [
      1120,
      600
    ],
    "views": [
      {
        "id": "versions",
        "label": "Versions",
        "focus": [
          "workcopy",
          "hqpkg",
          "store",
          "pointers",
          "home"
        ],
        "note": "Edits by anyone become the next run's version once checks pass; running sessions keep theirs."
      },
      {
        "id": "launch",
        "label": "One run",
        "focus": [
          "entry",
          "hqpkg",
          "store",
          "launch",
          "claude"
        ],
        "note": "Resolve a pinned snapshot, fill placeholders at run time, start Claude Code."
      },
      {
        "id": "auth",
        "label": "Services and auth",
        "focus": [
          "launch",
          "hqauth",
          "services",
          "authjson",
          "mcp"
        ],
        "note": "Only needed and granted services start; secrets live only in the server process."
      }
    ]
  },
