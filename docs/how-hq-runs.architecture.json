      "label": "resolve",
      "variant": "emphasis"
    },
    {
      "id": "fingerprint",
      "from": "workcopy",
      "to": "hqpkg",
      "label": "edits",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "snapshot",
      "from": "hqpkg",
      "to": "store",
      "label": "new version",
      "variant": "emphasis"
    },
    {
      "id": "good-pin",
      "from": "hqpkg",
      "to": "pointers",
      "label": "last good",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "template",
      "from": "store",
      "to": "launch",
      "label": "template",
      "variant": "emphasis"
    },
    {
      "id": "start",
      "from": "launch",
      "to": "claude",
      "label": "start",
      "variant": "emphasis"
    },
    {
      "id": "writes",
      "from": "claude",
      "to": "home",
      "label": "writes state",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "learned",
      "from": "home",
      "to": "workcopy",
      "label": "learned skills → next version",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "right"
    },
    {
      "id": "mcpconfig",
      "from": "launch",
      "to": "hqauth",
      "label": "needs",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "defs",
      "from": "services",
      "to": "hqauth",
      "label": "definitions"
    },
    {
      "id": "grants",
      "from": "authjson",
      "to": "hqauth",
      "label": "grant",
      "variant": "security",
      "fromSide": "top",
      "toSide": "bottom",
      "labelAt": [
        790,
        450
      ]
    },
    {
      "id": "inject",
      "from": "hqauth",
      "to": "mcp",
      "label": "secrets",
      "variant": "security"
    },
    {
      "id": "stdio",
      "from": "claude",
      "to": "mcp",
      "label": "tools",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Versions",
      "items": [
        "Every run pins a snapshot; edits never wait",
        "Failed checks → last good version runs",
        "hq versions · pin · rollback · unpin"
      ]
    },
    {
      "dot": "rose",
      "title": "Auth",
      "items": [
        "Service (repo) · need (package) · grant (yours)",
        "Secrets: Keychain, env file or env, by reference",
        "Every secret handed out is logged"
      ]
    },
    {
      "dot": "amber",
      "title": "Safety nets",
      "items": [
        "Versioning breaks → live folder runs",
        "auth.json breaks → run without services",
        "Least privilege, not a sandbox"
      ]
    }
  ]
}
