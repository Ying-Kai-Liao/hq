{
  "$comment": "Merged over your global ~/.claude/settings.json for this agent's runs (hq --settings). Narrow here: model, plugins, permissions. MCP servers come from shared services in capabilities.yaml needs (granted with hq-auth), or mcp.json next to this file. Placeholders: {{HQ}}, {{AGENT_DIR}} (pinned package), {{HOME_DIR}} (memory, data).",
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "cowork-plugin-management@synced": false,
    "data@synced": false,
    "engineering@synced": false,
    "enterprise-search@synced": false,
    "flow@flow": false,
    "impeccable@impeccable": false,
    "plugin-dev@claude-plugins-official": false,
    "productivity@synced": false,
    "skill-creator@claude-plugins-official": false,
    "vercel@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(/usr/bin/python3 {{AGENT_DIR}}/tools/imagegen.py:*)",
      "Bash(mkdir -p ~/Workspace/design/:*)",
      "Bash(mkdir -p {{USER_HOME}}/Workspace/design/:*)",
      "Bash(sips:*)",
      "Bash({{HQ}}/bin/hq-send:*)",
      "Read(~/Workspace/design/**)",
      "Edit(~/Workspace/design/**)",
      "Edit(/{{HOME_DIR}}/memory/**)",
      "Edit(/{{HOME_REAL}}/memory/**)",
      "Bash(uv run {{AGENT_DIR}}/tools/finish.py:*)",
      "Bash(uvx --from \"rembg[cpu,cli]==2.0.67\" rembg:*)",
      "Bash({{AGENT_DIR}}/tools/img:*)",
      "Bash(/usr/bin/python3 {{AGENT_DIR}}/tools/infographic.py:*)",
      "Bash(uv run {{AGENT_DIR}}/tools/chart.py:*)",
      "Bash({{AGENT_DIR}}/tools/diagram.sh:*)",
      "Bash({{HQ}}/bin/hq-send --as image:*)",
      "Bash(git log:*)",
      "Bash(git shortlog:*)",
      "Bash(wc:*)",
      "Edit(/{{HOME_DIR}}/recipes.md)",
      "Edit(/{{HOME_REAL}}/recipes.md)",
      "Edit(/{{HOME_DIR}}/skills/learned/**)",
      "Edit(/{{HOME_REAL}}/skills/learned/**)",
      "Bash(mkdir -p:*)",
      "Bash(ls:*)",
      "Bash(node {{AGENT_DIR}}/skills/anatomy/scripts/:*)",
      "Bash(node ~/Workspace/design/:*)",
      "Bash(node {{USER_HOME}}/Workspace/design/:*)",
      "Bash(cp -R {{AGENT_DIR}}/skills/anatomy/kit:*)"
    ],
    "deny": [
      "Edit(~/.codex/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.hermes/**/.env)",
      "Read(~/.config/hq/env)",
      "Read(~/.config/hq/auth.json)"
    ]
  }
}
